load("//.config/bazel:rust.bzl", "workspace_crate")

# Built for the host, as the all-features Cargo test run does; the wasm32
# component itself is still built by cargo component.
workspace_crate(
    name = "trogon-schedules-decider",
    # export_decider! expands to wit_bindgen over the WIT contract.
    compile_data = ["//rsworkspace/crates/decider/trogon-decider-wit:wit"],
    deps = [
        "//rsworkspace/crates/decider/trogon-decider",
        "//rsworkspace/crates/decider/trogon-decider-guest-sdk",
        "//rsworkspace/crates/platform/trogonai-proto",
        "//rsworkspace/crates/scheduler/trogon-scheduler-domain",
    ],
)
