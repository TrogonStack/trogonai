load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//.config/bazel:rust.bzl", "workspace_crate")

# Also built for the host, as the all-features Cargo test run does. The wasm32
# component is :component, checked by :component_test. export_decider! expands
# to wit_bindgen over the WIT contract.
workspace_crate(
    compile_data = ["//rsworkspace/crates/decider/trogon-decider-wit:wit"],
)

genrule(
    name = "descriptor",
    srcs = ["//proto:schedules_descriptor_set"],
    outs = ["component/trogon_schedules_decider.binpb"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "descriptor_test",
    srcs = ["//.config/bazel:decider_descriptor_test.sh"],
    args = [
        "$(rootpath :component)",
        "$(rootpath //.config/bazel:buf)",
        "$(rootpath //proto:buf_cache)",
        "$(rootpaths //proto:buf.yaml)",
        "$(rootpaths //proto:buf.lock)",
        "$(rootpaths //proto:sources)",
    ],
    data = [
        ":component",
        ":descriptor",
        "//proto:buf.lock",
        "//proto:buf.yaml",
        "//.config/bazel:buf",
        "//proto:buf_cache",
        "//proto:sources",
    ],
)
