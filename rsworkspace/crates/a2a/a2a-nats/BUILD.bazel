        "//rsworkspace/crates/a2a/a2a-pack",
        "//rsworkspace/crates/platform/jsonrpc-nats",
        "//rsworkspace/crates/platform/trogon-identity-types",
        "//rsworkspace/crates/platform/trogon-nats",
        "//rsworkspace/crates/platform/trogon-semconv",
        "//rsworkspace/crates/platform/trogon-std",
    ],
)
