load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "a2a-nats",
    # The workspace imports spicedb-grpc-tonic under the name authzed.
    aliases = {"@crates//:spicedb-grpc-tonic": "authzed"},
    crate_features = ["spicedb"],
    # The @crates labels are optional dependencies of the enabled features. No
    # workspace member enables those features, so crate_universe leaves them out.
    deps = [
        "//rsworkspace/crates/a2a/a2a-identity-types",
        "//rsworkspace/crates/a2a/a2a-pack",
        "//rsworkspace/crates/platform/jsonrpc-nats",
        "//rsworkspace/crates/platform/trogon-identity-types",
        "//rsworkspace/crates/platform/trogon-nats",
        "//rsworkspace/crates/platform/trogon-semconv",
        "//rsworkspace/crates/platform/trogon-std",
        "@crates//:moka",
        "@crates//:spicedb-grpc-tonic",
        "@crates//:tonic",
    ],
)
