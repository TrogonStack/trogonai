load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "a2a-gateway",
    binaries = {"a2a-gateway": {}},
    # crate_universe resolves only default features, so it leaves out the optional
    # crates spicedb turns on and Bazel builds the default-features gateway.
    dev_deps = ["//rsworkspace/crates/platform/trogonai-proto"],
    integration_tests = {
        # Runs the docker CLI against the repository's devops/ directory, which
        # lies outside this Bazel package.
        "compose_bootstrap_jwt": {"tags": ["manual"]},
        "default_build_enforces_policy": {"tags": ["requires-network"]},
        "imported_reply": {"tags": ["requires-network"]},
        "owner_emit_error": {},
        "run_smoke": {"tags": ["requires-network"]},
        "runtime_process": {
            "data": [":a2a-gateway_bin"],
            "rustc_env": {"CARGO_BIN_EXE_a2a-gateway": "$(rootpath :a2a-gateway_bin)"},
            "tags": ["requires-network"],
        },
        # Reads a2a-pack/policies through CARGO_MANIFEST_DIR/../, which is a
        # sibling Bazel package that does not export those files yet.
        "tier1_declarative_bundles": {"tags": ["manual"]},
        # Copies wasm fixtures from a2a-redaction/tests/fixtures, a sibling Bazel
        # package that does not export them yet.
        "tier3_manifest_boot": {"tags": ["manual"]},
    },
    # These two read a2a-redaction/tests/fixtures/identity_redact_part.wasm through
    # CARGO_MANIFEST_DIR/../, which the unit test target cannot resolve.
    unit_test_args = [
        "--skip",
        "policy::wasmtime_substrate::tests::register_redaction_skill_round_trips_fixture",
        "--skip",
        "runtime::policy_stack::tests::boot_tests::configured_skills_load_usable_bundles",
        "--skip",
        "runtime::policy_stack::tests::boot_tests::from_env_rejects_an_invalid_skill_slug",
    ],
    # Some tests start a NATS server in a container through Docker.
    unit_test_tags = ["requires-network"],
    deps = [
        "//rsworkspace/crates/a2a/a2a-auth-callout",
        "//rsworkspace/crates/a2a/a2a-nats",
        "//rsworkspace/crates/a2a/a2a-pack",
        "//rsworkspace/crates/a2a/a2a-redaction",
        "//rsworkspace/crates/platform/trogon-audit",
        "//rsworkspace/crates/platform/trogon-identity-types",
        "//rsworkspace/crates/platform/trogon-nats",
        "//rsworkspace/crates/platform/trogon-semconv",
        "//rsworkspace/crates/platform/trogon-std",
        "//rsworkspace/crates/platform/trogon-telemetry",
    ],
)
