load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "trogon-egress-proxy",
    binaries = {"trogon-egress-proxy": {}},
    integration_tests = {
        "egress": {"compile_data": glob(["tests/support/**/*.rs"])},
        # Starts a NATS JetStream server in a container through Docker.
        "live_policy_runtime": {
            "compile_data": glob(["tests/support/**/*.rs"]),
            "tags": ["requires-network"],
        },
        # Starts a TLS NATS JetStream cluster in containers through Docker.
        "scoped_workload_runtime": {"tags": ["requires-network"]},
        "startup": {
            "compile_data": glob(["tests/support/**/*.rs"]),
            "data": [":trogon-egress-proxy_bin"],
            "rustc_env": {"CARGO_BIN_EXE_trogon-egress-proxy": "$(rootpath :trogon-egress-proxy_bin)"},
        },
    },
    # Some unit tests start a NATS JetStream server in a container through Docker.
    unit_test_tags = ["requires-network"],
    deps = [
        "//rsworkspace/crates/platform/trogon-audit",
        "//rsworkspace/crates/platform/trogon-nats",
        "//rsworkspace/crates/platform/trogon-std",
        "//rsworkspace/crates/platform/trogon-workload-identity",
        "//rsworkspace/crates/platform/trogonai-proto",
    ],
)
