{
  "platform": "linux",
  "env": {
    "CLAUDE_CODE_ENTRYPOINT": "remote_cowork"
  },
  "process": {
    "euid": 4242,
    "uid": 4242,
    "egid": 4242,
    "gid": 4242,
    "groups": [
      4242
    ]
  },
  "writable": {
    "/mnt/c/Windows/System32/reg.exe": "yes",
    "/etc/claude-code/managed-settings.json": "yes",
    "*": "EACCES"
  },
  "options": {
    "cwd": "$ROOT/work",
    "settingSources": []
  },
  "steps": [
    {
      "at": 0,
      "files": {}
    },
    {
      "at": 1800000,
      "files": {
        "proc/version": "Linux version 5.15.153.1-microsoft-standard-WSL2\n"
      }
    }
  ]
}
