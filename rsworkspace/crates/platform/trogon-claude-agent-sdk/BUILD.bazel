load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//.config/bazel:rust.bzl", "workspace_crate")

rust_binary(
    name = "claude_sdk_fixture",
    srcs = ["tests/support/fixture_cli.rs"],
    crate_root = "tests/support/fixture_cli.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = ["-Dwarnings"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "claude_sdk_relay",
    srcs = ["tests/support/relay.rs"],
    crate_root = "tests/support/relay.rs",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
)

