load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    # Unit tests start a NATS server in a container through Docker.
    unit_test_tags = ["requires-network"],
    integration_tests = {
        # Test binaries share the `*_support` module directories through `#[path]` and `mod` items.
        "*": {
            "compile_data": [
                "tests/*/mod.rs",
                "tests/*_support/**/*.rs",
            ],
            "tags": ["requires-network"],
        },
    },
)
