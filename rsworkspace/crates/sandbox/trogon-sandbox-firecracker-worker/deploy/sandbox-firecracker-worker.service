[Unit]
Description=Sandbox Firecracker worker
Wants=network-online.target
After=network-online.target
ConditionPathExists=/dev/kvm
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/sandbox-fc/worker.env
Environment=SANDBOX_FIRECRACKER_JAILER_CGROUP_PARENT=system.slice/trogon-sandbox-firecracker-worker.service
ExecStart=/usr/local/bin/trogon-sandbox-firecracker-worker
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=180
StateDirectory=sandbox-fc
StateDirectoryMode=0700
CacheDirectory=sandbox-fc-images
CacheDirectoryMode=0700
RuntimeDirectory=sandbox-fc
RuntimeDirectoryMode=0700
Delegate=cpu memory pids
DelegateSubgroup=worker
CPUQuota=400%
MemoryMax=8G
TasksMax=1024
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
