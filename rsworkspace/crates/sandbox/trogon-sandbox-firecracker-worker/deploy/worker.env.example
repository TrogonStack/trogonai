SANDBOX_NATS_URL=nats://127.0.0.1:4222
SANDBOX_FIRECRACKER_BINARY=/usr/local/bin/firecracker
SANDBOX_FIRECRACKER_JAILER=/usr/local/bin/jailer
SANDBOX_FIRECRACKER_KERNEL=/srv/sandbox-fc/vmlinux
SANDBOX_FIRECRACKER_ROOTFS=/srv/sandbox-fc/rootfs.ext4
SANDBOX_FIRECRACKER_STATE_DIR=/var/lib/sandbox-fc
SANDBOX_FIRECRACKER_IMAGE=guest:base
SANDBOX_FIRECRACKER_MAX_CONCURRENT_LEASES=4
SANDBOX_FIRECRACKER_DEFAULT_MEMORY_MIB=512
SANDBOX_FIRECRACKER_VCPUS=2
