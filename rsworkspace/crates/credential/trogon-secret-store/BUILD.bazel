load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "trogon-secret-store",
    # The OpenBao test harness reads the service policies with include_str!.
    compile_data = ["//devops/openbao/policies:secrets_service_policies"],
    crate_features = ["test-support"],
    # Some unit tests start an OpenBao server in a container through Docker.
    unit_test_tags = ["requires-network"],
    deps = [
        "//rsworkspace/crates/credential/trogon-credential-domain",
        "//rsworkspace/crates/platform/trogon-std",
    ],
)
