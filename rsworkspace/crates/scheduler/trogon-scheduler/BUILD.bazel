load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "trogon-scheduler",
    # The migrations are embedded by sqlx::migrate!, and tests/support is pulled in by
    # #[path] attributes, both at compile time.
    compile_data = glob([
        "migrations/**",
        "tests/support/*.rs",
    ]),
    crate_features = [
        "postgres",
        "test-support",
    ],
    dev_deps = ["//rsworkspace/crates/decider/trogon-decider"],
    integration_tests = {
        # These start NATS and Postgres in containers through Docker.
        "integration": {
            "compile_data": glob(["tests/support/*.rs"]),
            "tags": ["requires-network"],
        },
        "postgres_projection": {
            "compile_data": glob(["tests/support/*.rs"]),
            "tags": ["requires-network"],
        },
        "postgres_projector_e2e": {
            "compile_data": glob(["tests/support/*.rs"]),
            "tags": ["requires-network"],
        },
        "schedule_unit": {},
    },
    # Some tests start NATS and Postgres in containers through Docker.
    unit_test_tags = ["requires-network"],
    deps = [
        "//rsworkspace/crates/decider/trogon-decider-nats",
        "//rsworkspace/crates/decider/trogon-decider-runtime",
        "//rsworkspace/crates/platform/trogon-nats",
        "//rsworkspace/crates/platform/trogon-semconv",
        "//rsworkspace/crates/platform/trogon-std",
        "//rsworkspace/crates/platform/trogon-telemetry",
        "//rsworkspace/crates/platform/trogonai-proto",
        "//rsworkspace/crates/scheduler/trogon-scheduler-domain",
    ],
)
