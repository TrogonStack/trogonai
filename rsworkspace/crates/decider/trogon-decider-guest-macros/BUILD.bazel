load("//.config/bazel:rust.bzl", "workspace_crate")

workspace_crate(
    name = "trogon-decider-guest-macros",
    # The dev-dependencies are only used by the trybuild fixtures in tests/ui.
    dev_deps = [
        "//rsworkspace/crates/decider/trogon-decider",
        "//rsworkspace/crates/decider/trogon-decider-guest-sdk",
        "//rsworkspace/crates/platform/trogonai-proto",
        "//rsworkspace/crates/scheduler/trogon-scheduler-domain",
    ],
    integration_tests = {
        "compile_fail": {
            # trybuild shells out to cargo to build the fixtures, which Bazel cannot provide.
            "tags": ["manual"],
        },
    },
    proc_macro = True,
    deps = ["//rsworkspace/crates/decider/trogon-decider-wit"],
)
