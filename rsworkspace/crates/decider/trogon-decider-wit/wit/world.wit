// 0.3.0: `command-spec` gained a required `snapshot-policy` and its `write-precondition` lost the
// `option<>` wrapper, so a module now declares both its concurrency guard and its snapshot cadence
// rather than leaving either to the host. Guest and host bindings must be regenerated from the same
// WIT version; this is not wire-compatible with 0.2.0.
package trogon:decider@0.3.0;

/// Contract every compiled Trogon decider component exports.
interface handler {
  /// A stored event envelope: its persistent type name plus the encoded domain event payload.
  record any-envelope {
    /// Persistent event type name stored alongside the payload.
    %type: string,
    /// Encoded domain event payload.
    payload: list<u8>,
  }

  /// An incoming command envelope: its command type plus the encoded command payload.
  record command-envelope {
    /// Persistent command type name stored alongside the payload.
    %type: string,
    /// Encoded domain command payload.
    payload: list<u8>,
  }

  /// A structured guest-side error surfaced to the host.
  record domain-error {
    /// Stable, machine-readable rejection code (see `Decider::decide-error-code` on the guest).
    code: string,
    /// Human-readable description of the failure.
    message: string,
    /// Ordered key/value pairs carrying the error's source chain, most specific cause last.
    details: list<tuple<string, string>>,
  }

  /// Concurrency guard a command's meaning requires when its emitted events are appended.
  ///
  /// Mirrors the guest-side `trogon-decider` enum of the same name. Every case is a predicate over
  /// the stream's state at append time. A caller-supplied expected revision can strengthen the
  /// declared guard host-side, but never weaken it.
  variant write-precondition {
    /// Append only if the stream is still exactly as replay observed it. The host supplies the
    /// observed position, which is why this case names the intent rather than a revision.
    stream-unchanged,
    /// Append only if the stream has no events, so the first of several concurrent writers wins.
    no-stream,
    /// Append only if the stream already has at least one event.
    stream-exists,
    /// Append regardless of the stream's current state. Only for commands whose events commute.
    any,
  }

  /// How often the host should persist a snapshot of the session's state for a command.
  ///
  /// Mirrors the host-side `SnapshotPolicy` implementations the native path selects through
  /// `CommandSnapshotPolicy`, so a decider keeps one cadence across both execution paths.
  variant snapshot-policy {
    /// Never snapshot. The host does not call `session.snapshot` for this command.
    no-snapshot,
    /// Snapshot once at least this many events have been read or appended since the last one.
    ///
    /// Must be greater than zero; a host rejects the module at registration otherwise. A host may
    /// also clamp the value up to a configured floor so a module cannot impose an arbitrary
    /// snapshot-write rate on shared storage.
    frequency(u64),
  }

  /// One command type a decider module handles, plus the policies its execution requires.
  record command-spec {
    /// Persistent command type name this spec covers.
    command-type: string,
    /// Concurrency guard this command's events require on append.
    write-precondition: write-precondition,
    /// Snapshot cadence the host applies after this command's events are appended.
    snapshot-policy: snapshot-policy,
  }

  /// Static identity and command coverage of a compiled decider module, returned by `descriptor`.
  record module-descriptor {
    /// Module name. Combined with `version`, identifies the module for snapshot routing.
    name: string,
    /// Module version. Opaque to the runtime; used only for identity, not ordering.
    version: string,
    /// Command types this module handles.
    commands: list<command-spec>,
  }

  /// Outcome of a failed `session.decide` call.
  variant decide-error {
    /// The command was understood but rejected by domain rules.
    rejected(domain-error),
    /// The guest could not evaluate the command (e.g. a decode failure).
    faulted(domain-error),
  }

  /// Returns this module's static identity and the commands it handles.
  descriptor: func() -> module-descriptor;

  /// Resolves the stream identifier a command targets, without evaluating it.
  stream-id: func(command: command-envelope) -> result<string, domain-error>;

  /// One command's execution lifecycle: replay prior events, decide, then snapshot.
  resource session {
    /// Creates a session, optionally resuming from a previously taken snapshot.
    constructor(snapshot: option<list<u8>>);

    /// Applies one stored event to the session's in-guest state.
    evolve: func(events: list<any-envelope>) -> result<_, domain-error>;

    /// Evaluates a command against the current state, returning the events it produces.
    ///
    /// The success case must be a non-empty list: a command that decides
    /// nothing is a domain modeling error and must be reported through
    /// `decide-error` instead of `ok([])`. The WIT type system cannot express
    /// this, so hosts and guests must enforce it themselves.
    decide: func(command: command-envelope) -> result<list<any-envelope>, decide-error>;

    /// Serializes the session's current state, or `none` if the state is not snapshottable.
    ///
    /// Cadence is not decided here: the host calls this only when the command's
    /// `snapshot-policy` says a snapshot is due.
    snapshot: func() -> option<list<u8>>;
  }
}

/// The world every compiled Trogon decider component implements.
world decider {
  export handler;
}
