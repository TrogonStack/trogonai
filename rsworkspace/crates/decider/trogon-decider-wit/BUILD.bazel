load("//.config/bazel:rust.bzl", "workspace_crate")

# The WIT contract, for crates whose `export_decider!` expansion reads it.
filegroup(
    name = "wit",
    srcs = glob(["wit/**"]),
    visibility = ["//visibility:public"],
)

workspace_crate(
    name = "trogon-decider-wit",
    compile_data = [":wit"],
    crate_features = [
        "guest",
        "host",
    ],
    data = [":wit"],
    # WIT_DIR bakes CARGO_MANIFEST_DIR into a constant that `export_decider!`
    # reads while other crates compile. Inside a sandbox that path is private to
    # this action, so compiling outside it keeps the path valid for every reader.
    library_tags = ["no-sandbox"],
    unit_test_tags = ["no-sandbox"],
    # The `guest` feature's optional dependency, which no workspace member
    # enables, so crate_universe leaves it out of this crate's dependencies.
    deps = ["@crates//:wit-bindgen"],
)
