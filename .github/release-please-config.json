{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    }
  ],
  "packages": {
    "rsworkspace/crates/acp/acp-nats-stdio": {
      "component": "acp-nats-stdio",
      "extra-files": [
        {
          "type": "toml",
          "path": "/rsworkspace/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value===\"acp-nats-stdio\")].version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "tag-separator": "@",
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "release-type": "rust",
  "draft": false,
  "draft-pull-request": false,
  "prerelease": false,
  "pull-request-header": "An automated release has been created for you.",
  "separate-pull-requests": true,
  "signoff": "Straw Hat Team Bot <61149376+sht-bot@users.noreply.github.com>"
}
