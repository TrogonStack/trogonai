+/// The managed settings goldens of each Unix profile, whose cases name each boundary Node measured by the profile key
+/// that names it and the level they read.
+const MEASURED: [(NodeStack, &str); 3] = [
+    (
+        NodeStack::NODE_24_DARWIN_ARM64,
+        include_str!("../tests/fixtures/settings_resolve/ts_managed_settings.json"),
+    ),
+    (
+        NodeStack::NODE_24_LINUX_ARM64,
+        include_str!("../tests/fixtures/settings_resolve/ts_managed_settings_linux_arm64.json"),
+    ),
+    (
+        NodeStack::NODE_24_LINUX_X64,
+        include_str!("../tests/fixtures/settings_resolve/ts_managed_settings_linux_x64.json"),
+    ),
+];
+
+type MeasuredResult<T> = Result<T, Box<dyn std::error::Error>>;
+
+/// The boundary the goldens record for `key`: the last level that fits, which they read in a case named
+/// `<key>_<level>` next to one a level deeper. A rename or a missing case fails here instead of skipping the check.
+fn measured_boundary(goldens: &Value, key: &str) -> MeasuredResult<i64> {
+    let cases = goldens["cases"].as_array().ok_or("the goldens have no cases")?;
+    let mut levels = Vec::new();
+    for case in cases {
+        let name = case["name"].as_str().ok_or("a case of the goldens has no name")?;
+        if let Some(level) = name.strip_prefix(key).and_then(|rest| rest.strip_prefix('_'))
+            && let Ok(level) = level.parse::<i64>()
+        {
+            levels.push(level);
+        }
+    }
+    levels.sort_unstable();
+    match levels.as_slice() {
+        [near, far] if near.checked_add(1) == Some(*far) => Ok(*near),
+        _ => Err(format!("the goldens read {levels:?} for {key}, not one level and the next").into()),
+    }
+}
+
+/// The evaluations of the policy origin and of whether the machine policy loaded have more room than the one for the
+/// sources by what V8 spent before each began, which their copy budgets measure under `__proto__`. Every boundary
+/// Node measured for those evaluations sits within one step of the sources' boundary moved by that much, in each
+/// pass, so no budget of theirs rests on that gain alone.
+#[test]
+fn every_later_evaluation_boundary_node_measured_moves_by_the_room_the_copy_measured() -> MeasuredResult<()> {
+    for (stack, text) in MEASURED {
+        let goldens: Value = serde_json::from_str(text)?;
+        let policy = stack.policy;
+        let origin = i64::try_from(policy.origin.copy)? - i64::try_from(policy.sources.copy)?;
+        let machine = i64::try_from(policy.machine_policy.copy)? - i64::try_from(policy.sources.copy)?;
+        // The `__proto__` case holds its arrays under one object more and closes them with one array more.
+        let proto_extra = i64::try_from(stack.copy.object + stack.copy.array)?;
+        for (sources_key, later_key, step, gain, extra) in [
+            ("drop_read", "origin_read", stack.walk.object, origin, 0),
+            ("drop_read", "machine_read", stack.walk.object, machine, 0),
+            ("drop_read_arrays", "origin_read_arrays", stack.clone.array, origin, 0),
+            ("drop_read_arrays", "machine_read_arrays", stack.clone.array, machine, 0),
+            ("sources_copy", "origin_copy", stack.copy.array, origin, proto_extra),
+            ("sources_copy", "machine_copy", stack.copy.array, machine, 0),
+            ("drop_merge", "origin_merge", stack.merge.level, origin, 0),
+            ("drop_merge", "machine_merge", stack.merge.level, machine, 0),
+        ] {
+            let step = i64::try_from(step)?;
+            let levels = measured_boundary(&goldens, later_key)? - measured_boundary(&goldens, sources_key)?;
+            let spent = levels * step + extra;
+            assert!(
+                (spent - gain).abs() < step,
+                "{}: {later_key} is {levels} levels past {sources_key}, {spent} bytes against {gain}",
+                goldens["node"]
+            );
+        }
+    }
+    Ok(())
+}
