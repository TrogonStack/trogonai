+            (NodeStack::NODE_24_LINUX_ARM64, ResumeBase::Tool, 1914, 3062, 1749, 3063),
+            (NodeStack::NODE_24_LINUX_X64, ResumeBase::Fs, 1621, 3242, 1539, 3243),
+            (NodeStack::NODE_24_LINUX_X64, ResumeBase::Tool, 1621, 3241, 1539, 3242),
+        ] {
