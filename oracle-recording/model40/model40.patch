+    /// A registry or managed preferences document handed over as text (`hm` upstream), parsed after a completion of
+    /// kind `base` and read the way `file` is read, with what the user could write taken out when `user_writable`. In the TypeScript dialect the
+    /// policy cache clones and walks the document, then copies the settings its schema kept, on the Node stack, and
+    /// nothing catches the `RangeError` when one of them runs out of it.
+    pub(crate) fn read_registry(
+        self,
+        base: ResumeBase,
+        text: &str,
+        user_writable: bool,
+        file: &str,
+    ) -> Result<TierRead, ResolveSettingsError> {
+        if matches!(self.decoder, Decoder::Lossy) {
+            return Ok(TierRead::from_hm(text, user_writable, file));
+        }
+        let reader = PolicyReader::Registry(base);
+        let document = match parse_policy_document(text, self.node.policy_max_depth(reader)) {
+            PolicyParse::Object(mut document) => {
+                for entry in document.values_mut() {
+                    normalize_numbers(entry, SettingsDialect::TypeScript);
+                }
