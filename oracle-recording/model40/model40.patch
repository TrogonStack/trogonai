+/// A WSL session whose machine registry policy holds `machine` and whose user registry policy holds `user`, or has
+/// no value when `None`.
+fn wsl_registry_host(machine: &str, user: Option<&str>) -> FakeHost {
+    let machine_line = "/mnt/c/Windows/System32/reg.exe query HKLM\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+    let user_line = "/mnt/c/Windows/System32/reg.exe query HKCU\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+    let value = |hive: &str, document: &str| {
+        format!("\r\n{hive}\\SOFTWARE\\Policies\\ClaudeCode\r\n    Settings    REG_SZ    {document}\r\n")
+    };
+    let host = FakeHost::linux()
+        .variable("WSL_DISTRO_NAME", "Ubuntu")
+        .command(machine_line, ok(&value("HKEY_LOCAL_MACHINE", machine)));
+    match user {
+        Some(user) => host.command(user_line, ok(&value("HKEY_CURRENT_USER", user))),
+        None => host.command(
+            user_line,
+            exited(
+                1,
+                "ERROR: The system was unable to find the specified registry key or value.",
+            ),
+        ),
+    }
+}
