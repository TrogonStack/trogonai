+#[test]
+fn a_registry_policy_after_a_byte_order_mark_loads() {
+    // `hm` parses the value through `u4`, which drops one leading byte order mark as the managed settings file
+    // reader does; recorded from the pinned TypeScript resolver.
+    let host = wsl_registry_host("\u{feff}{\"wslInheritsWindowsSettings\":true,\"model\":\"bom\"}", None);
+    assert_eq!(
+        printed(&host, json!({"settingSources": []})),
