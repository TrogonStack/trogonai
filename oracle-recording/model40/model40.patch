+pub(crate) enum PolicyReader {
+    /// A read in the evaluation of the managed file tier (`pE` upstream) for the sources, which fills the file cache
+    /// the evaluation for the effective settings reads from.
+    Sources,
+    /// A read in the evaluation for the policy origin, of a drop-in no evaluation before it reached.
+    Origin,
+    /// A read in the evaluation for the machine policy, of a drop-in no evaluation before it reached.
+    MachinePolicy,
+    /// The check of whether a managed folder holds settings that keep the user registry out (`n8` through `nD`),
+    /// on the stack of the completion its chain resumed from. Its reads go around the file cache and merge nothing.
+    HeldCheck(ResumeBase),
+    /// The parse of a registry or managed preferences document handed over as text (`hm` upstream), which the policy
+    /// cache (`pm`) clones and walks on the stack of the completion its chain resumed from.
+    Registry(ResumeBase),
+}
