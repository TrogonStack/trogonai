+/// A WSL session whose machine and user policies both inherit the Windows managed settings, with a Linux managed
+/// settings file of `size` bytes that holds an empty object.
+fn wsl_user_policy_host(size: usize) -> FakeHost {
+    let machine = "/mnt/c/Windows/System32/reg.exe query HKLM\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+    let user = "/mnt/c/Windows/System32/reg.exe query HKCU\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+    FakeHost::linux()
+        .variable("WSL_DISTRO_NAME", "Ubuntu")
+        .command(
+            machine,
+            ok("\r\nHKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\ClaudeCode\r\n    Settings    REG_SZ    {\"wslInheritsWindowsSettings\":true}\r\n"),
+        )
+        .command(
+            user,
+            ok("\r\nHKEY_CURRENT_USER\\SOFTWARE\\Policies\\ClaudeCode\r\n    Settings    REG_SZ    {\"wslInheritsWindowsSettings\":true,\"model\":\"user-registry\"}\r\n"),
+        )
+        .file(
+            "/etc/claude-code/managed-settings.json",
+            &format!("{}{{}}", " ".repeat(size - 2)),
+        )
+}
+
+#[test]
+fn wsl_user_policy_yields_to_a_managed_file_too_large_to_read() {
+    // Recorded from the pinned TypeScript resolver with the same registry answers and file sizes: a file within
+    // the read limit that holds nothing leaves the user policy in force, one past it counts as held.
+    let within = resolve(&wsl_user_policy_host(2_097_152), json!({"settingSources": []}));
+    assert_eq!(
+        js_stringify(&within),
+        r#"{"effective":{"model":"user-registry"},"provenance":{"model":{"source":"managed","policyOrigin":"hkcu"}},"sources":[{"source":"managed","settings":{"model":"user-registry"},"policyOrigin":"hkcu"}],"machinePolicy":{"didNotLoad":false}}"#
+    );
+    let past = resolve(&wsl_user_policy_host(2_097_153), json!({"settingSources": []}));
+    assert_eq!(
+        js_stringify(&past),
+        r#"{"effective":{},"provenance":{},"sources":[],"machinePolicy":{"didNotLoad":["file"]}}"#
+    );
+}
