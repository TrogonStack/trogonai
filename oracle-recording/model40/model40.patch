+#[test]
+fn a_registry_policy_holds_only_what_its_schema_read_kept() {
+    // Recorded from the pinned TypeScript resolver with the same registry answers: `hm` hands the policy cache's
+    // schema read of the document on, so a value of the wrong type never reaches the tier, the user registry's
+    // opt-in is asked of what the read kept, and a document whose only setting the read dropped still holds the
+    // machine policy.
+    let machine = wsl_registry_host(
+        r#"{"model":5,"permissions":{"allow":["Read"]},"wslInheritsWindowsSettings":true}"#,
+        None,
+    );
+    assert_eq!(
+        printed(&machine, json!({"settingSources": []})),
+        r#"{"result":{"effective":{"wslInheritsWindowsSettings":true,"permissions":{"allow":["Read"]}},"provenance":{"wslInheritsWindowsSettings":{"source":"managed","policyOrigin":"hklm"},"permissions":{"source":"managed","policyOrigin":"hklm"}},"sources":[{"source":"managed","settings":{"wslInheritsWindowsSettings":true,"permissions":{"allow":["Read"]}},"policyOrigin":"hklm"}],"machinePolicy":{"didNotLoad":false}},"filtered":{"wslInheritsWindowsSettings":true,"permissions":{"allow":["Read"]}}}"#
+    );
+    let user = wsl_registry_host(
+        r#"{"wslInheritsWindowsSettings":true}"#,
+        Some(r#"{"model":5,"permissions":{"allow":["Read"]},"wslInheritsWindowsSettings":true}"#),
+    );
+    assert_eq!(
+        printed(&user, json!({"settingSources": []})),
+        r#"{"result":{"effective":{"permissions":{"allow":["Read"]}},"provenance":{"permissions":{"source":"managed","policyOrigin":"hkcu"}},"sources":[{"source":"managed","settings":{"permissions":{"allow":["Read"]}},"policyOrigin":"hkcu"}],"machinePolicy":{"didNotLoad":false}},"filtered":{"permissions":{"allow":["Read"]}}}"#
+    );
+    let dropped = wsl_registry_host(r#"{"model":5,"wslInheritsWindowsSettings":true}"#, None)
+        .file("/etc/claude-code/managed-settings.json", r#"{"model":"file"}"#);
+    assert_eq!(
+        printed(&dropped, json!({"settingSources": []})),
+        r#"{"result":{"effective":{},"provenance":{},"sources":[],"machinePolicy":{"didNotLoad":false}},"filtered":{}}"#
+    );
+}
