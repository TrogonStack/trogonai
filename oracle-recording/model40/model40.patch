+//! Scratch scan for the model40 job, never committed: for each group of a case, host, call position and startup,
+//! the offsets of each context's interval on the 16-byte grid where the engine gives each recorded answer with its
+//! stage. A context run in full lists every offset that gives each answer, with the runs of what the engine gives;
+//! one that is not stops once every answer has a witness, and runs in full when one has none.
+
+use std::{
+    env, fs,
+    io::Write,
+    sync::{
+        Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    thread,
+    time::Instant,
+};
+
+use serde_json::{Value, json};
+
+use super::{DEEP_STACK_BYTES, Failure, HOSTS, STEP, TestResult, answer_at};
+
+fn whole(value: &Value, what: &'static str) -> Result<isize, Failure> {
+    Ok(value
+        .as_i64()
+        .and_then(|value| isize::try_from(value).ok())
+        .ok_or(what)?)
+}
+
+fn context(files: &Value, call: &str, stack: crate::NodeStack, io: isize, scan: &Value) -> Result<Value, Failure> {
+    let (low, high) = (whole(&scan["low"], "no low")?, whole(&scan["high"], "no high")?);
+    let every = scan["all"].as_bool().ok_or("no all")?;
+    let targets = scan["targets"].as_array().ok_or("no targets")?;
+    let mut found: Vec<Vec<isize>> = vec![Vec::new(); targets.len()];
+    let mut answers: Vec<Value> = Vec::new();
+    let mut runs: Vec<Value> = Vec::new();
+    let mut at = high;
+    let mut scanned = 0usize;
+    while at >= low {
+        let (answered, stage) = match answer_at(files, call, stack.resumed_by(at), stack.resumed_by(io)) {
+            Ok(given) => given,
+            Err(error) => (json!({"scan_error": error.to_string()}), "scan_error".to_owned()),
+        };
+        scanned += 1;
+        for (index, target) in targets.iter().enumerate() {
+            let stage_matches = target[1].as_str().is_none_or(|named| named == stage);
+            if target[0] == answered && stage_matches {
+                found[index].push(at);
+            }
+        }
+        let index = if let Some(index) = answers.iter().position(|seen| *seen == answered) {
+            index
+        } else {
+            answers.push(answered);
+            answers.len() - 1
+        };
+        match runs.last_mut() {
+            Some(last) if last[2] == json!(index) && last[3] == json!(stage) => last[1] = json!(at),
+            _ => runs.push(json!([at, at, index, stage])),
+        }
+        if !every && found.iter().all(|offsets| !offsets.is_empty()) {
+            break;
+        }
+        at -= STEP;
+    }
+    let complete = found.iter().all(|offsets| !offsets.is_empty());
+    let mut out = json!({"context": scan["context"], "found": found, "scanned": scanned});
+    if every || !complete {
+        out["runs"] = json!(runs);
+        out["answers"] = json!(answers);
+    }
+    Ok(out)
+}
+
+fn scan(group: &Value) -> Result<Value, Failure> {
+    let host = group["host"].as_str().ok_or("no host")?;
+    let (_, profile) = HOSTS.iter().find(|(name, _)| *name == host).ok_or("unknown host")?;
+    let call = group["call"].as_str().ok_or("no call")?;
+    let startup = usize::try_from(whole(&group["startup"], "no startup")?)?;
+    let stack = profile.with_startup_bytes(startup);
+    let started = Instant::now();
+    let scans = group["scans"].as_array().ok_or("no scans")?;
+    // Every organization answer is the same at each offset of the I/O interval, so its top stands for the completion.
+    let io = whole(
+        &scans.iter().find(|scan| scan["context"] == "io").ok_or("no io scan")?["high"],
+        "no io high",
+    )?;
+    let scans = scans
+        .iter()
+        .map(|scan| context(&group["files"], call, stack, io, scan))
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(json!({"key": group["key"], "scans": scans, "seconds": started.elapsed().as_secs_f64()}))
+}
+
+#[test]
+fn scan40() -> TestResult {
+    let (Ok(rows), Ok(out)) = (env::var("SCAN40_ROWS"), env::var("SCAN40_OUT")) else {
+        return Ok(());
+    };
+    let shard: usize = env::var("SCAN40_SHARD").map_or(Ok(1), |value| value.parse())?;
+    let shards: usize = env::var("SCAN40_SHARDS").map_or(Ok(1), |value| value.parse())?;
+    let groups: Vec<Value> = fs::read_to_string(rows)?
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .enumerate()
+        .filter(|(at, _)| at % shards == shard - 1)
+        .map(|(_, line)| serde_json::from_str(line))
+        .collect::<Result<_, _>>()?;
+    let out = Mutex::new(fs::File::create(out)?);
+    let next = AtomicUsize::new(0);
+    let workers = thread::available_parallelism().map_or(1, usize::from);
+    eprintln!("scan40: {} groups on {workers} workers", groups.len());
+    thread::scope(|scope| -> TestResult {
+        let mut running = Vec::new();
+        for _ in 0..workers {
+            running.push(thread::Builder::new().stack_size(DEEP_STACK_BYTES).spawn_scoped(
+                scope,
+                || -> TestResult {
+                    loop {
+                        let at = next.fetch_add(1, Ordering::SeqCst);
+                        let Some(group) = groups.get(at) else {
+                            return Ok(());
+                        };
+                        let line = match scan(group) {
+                            Ok(line) => line,
+                            Err(error) => json!({"key": group["key"], "error": error.to_string()}),
+                        };
+                        let mut file = out.lock().map_err(|_| "the scan output lock is poisoned")?;
+                        writeln!(file, "{line}")?;
+                        file.flush()?;
+                        eprintln!("scan40: group {at} done");
+                    }
+                },
+            )?);
+        }
+        for worker in running {
+            worker.join().map_err(|_| "a scan worker panicked")??;
+        }
+        Ok(())
+    })
+}
