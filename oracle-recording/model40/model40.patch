@@ -0,0 +1,61 @@
+use super::{Policy, Reading};
+use crate::{
+    adapters::ExecuteFileStatus,
+    settings_resolve_platform::{CommandOutcome, MdmEvaluation},
+    settings_resolve_tier::TierRead,
+    settings_resolve_values::SettingsMap,
+};
+
+/// A reading with no policy whose machine registry run answered or not.
+fn reading(machine_answered: bool) -> Reading {
+    let outcome = |answered: bool| CommandOutcome {
+        status: if answered {
+            ExecuteFileStatus::Ok
+        } else {
+            ExecuteFileStatus::Killed
+        },
+        exit_code: None,
+        errno: None,
+        answered,
+    };
+    Reading {
+        evaluation: MdmEvaluation {
+            mdm: TierRead::absent(),
+            hkcu: SettingsMap::new(),
+            wsl_inherits: false,
+            plist: None,
+            unread_without_errno: false,
+            blocking_error: false,
+            where_asked: None,
+            held_documents: Vec::new(),
+        },
+        hklm: Some(outcome(machine_answered)),
+        hkcu: Some(outcome(true)),
+    }
+}
+
+/// `startLoad` upstream hands the first read to `replace`, which sets `sdkReread.lastReadAt` to `Date.now()` once
+/// the read has outcomes, so `o8` measures every later call from the instant the first read ended and never from the
+/// `lastReadAt:0` the field starts with.
+#[test]
+fn the_first_read_starts_the_reread_clock_at_the_instant_it_ended() {
+    for machine_answered in [true, false] {
+        let policy = Policy::loaded(reading(machine_answered), 1_700_000_000_000, false);
+        assert_eq!(
+            (
+                policy.last_read_at,
+                policy.unanswered_in_a_row,
+                policy.answered_once,
+                policy.loss_seen.as_str(),
+                policy.in_flight.is_none()
+            ),
+            (
+                1_700_000_000_000,
+                u32::from(!machine_answered),
+                machine_answered,
+                "",
+                true
+            )
+        );
+    }
+}
