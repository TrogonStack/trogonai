+            }
+            PolicyParse::NotObject => None,
+            PolicyParse::Overflow => return Err(ResolveSettingsError::MaximumCallStack),
+        };
+        if let Some(document) = &document
+            && !self.node.reads_policy(reader, document)
+        {
+            return Err(ResolveSettingsError::MaximumCallStack);
+        }
+        let tier = TierRead::from_hm_object(document, user_writable, file);
+        if let Some(settings) = tier.settings.as_ref().filter(|_| tier.load_state == LoadState::Loaded)
+            && self.node.registry_copy_overflows(base, settings)
