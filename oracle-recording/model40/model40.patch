+//! Each answer the pinned TypeScript `resolveSettings` gave for a managed settings case at and around the edges of the
+//! goldens, from each caller context the recorder awaits it in: the top level of a module, a chain nested in another,
+//! and the callback of a timer, an immediate, an I/O completion and a child process exit. The caller's frames sit
+//! under the chain of microtasks the resolve resumes on, so each context gives the resolve its own room: the timer,
+//! immediate and I/O callbacks the same room on every run, a child process exit a room that moves from one process to
+//! the next. Each answer must be the model's answer, with the same `catch` blocks taking the `RangeError`, at an offset
+//! inside the interval the refit measured for its host, call position and context, on the 16-byte grid; one offset
+//! explains every case of a timer, an immediate or an I/O callback.
+
+use std::{collections::BTreeSet, thread};
+
+use serde_json::{Map, Value, json};
+
+use crate::{
+    DeepJsonValue, NodeStack, PolicyRereads, ResolveSettingsError, ResolveSettingsOptions, ResolverState, js_stringify,
+    node_stack_catch::{self, StackCatch},
+    resolve_settings_with_state,
+};
+
+#[path = "../tests/support/fake_settings_host.rs"]
+mod fake_settings_host;
+
+use fake_settings_host::{FakeHost, exited, ok};
+
+type Failure = Box<dyn std::error::Error + Send + Sync>;
+type TestResult = Result<(), Failure>;
+
+const ANSWERS: &str = include_str!("../tests/fixtures/settings_resolve/ts_managed_context_answers.json");
+
+/// The profile of each host the answers were recorded on. Under a WSL 2 kernel the host is the same linux x86_64.
+const HOSTS: [(&str, NodeStack); 4] = [
+    ("darwin arm64", NodeStack::NODE_24_DARWIN_ARM64),
+    ("linux aarch64", NodeStack::NODE_24_LINUX_ARM64),
+    ("linux x86_64", NodeStack::NODE_24_LINUX_X64),
+    ("wsl x86_64", NodeStack::NODE_24_LINUX_X64),
+];
+
+/// The callers that resume at the same depth on every run.
+const SETTLED: [&str; 3] = ["timer", "immediate", "io"];
+
+/// Every caller context the recorder awaits a resolve in.
+const CONTEXTS: [&str; 6] = ["toplevel", "nested", "timer", "immediate", "io", "child_exit"];
+
+/// The grid the offsets of a caller sit on: V8 keeps its frames 16-byte aligned.
+const STEP: isize = 16;
+
+/// Room for walking, printing and dropping the deepest settings documents of the answers.
+const DEEP_STACK_BYTES: usize = 256 * 1024 * 1024;
+
+const DROP_INS: &str = "/etc/claude-code/managed-settings.d";
+
+/// The entry point an organization case starts the session as.
+const ORGANIZATION_ENTRYPOINT: (&str, &str) = ("CLAUDE_CODE_ENTRYPOINT", "remote_cowork");
+
+/// What the model runs to read the machine and the user registry policy under WSL, as the fake host keys a command.
+const MACHINE_QUERY: &str = "/mnt/c/Windows/System32/reg.exe query HKLM\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+const USER_QUERY: &str = "/mnt/c/Windows/System32/reg.exe query HKCU\\SOFTWARE\\Policies\\ClaudeCode /v Settings";
+
+/// What the recorder's stand-in for `reg.exe` prints for a key it holds no value for, before it exits with 1.
+const REGISTRY_ABSENT: &str = "ERROR: The system was unable to find the specified registry key or value.\n";
+
+/// The kernel every resolve of an organization case finds, and how long after the first the second starts. The
+/// recorder runs those cases on a real WSL 2 kernel, so `Gc` upstream reads WSL from `/proc/version` at both
+/// resolves, and the oracle drops the `/proc/version` stand-in of the case instead of serving it.
+const WSL_KERNEL: (&str, &str) = ("/proc/version", "Linux version 5.15.153.1-microsoft-standard-WSL2\n");
+const WSL_AT_MS: u64 = 1_800_000;
+
+/// How the held registry document of the recorder's `org_cache_kept` cases starts: objects under a member of a server
+/// entry, where every other organization case holds arrays or nothing. Only those cases find the drop-in
+/// `KEPT_DROP_IN` at their second resolve.
+const KEPT_HELD_START: &str =
+    r#"{"permissions":{"deny":["Bash(curl:*)"]},"allowedMcpServers":[{"serverName":"h","z":{"#;
+const KEPT_DROP_IN: (&str, &str, &str) = (
+    "/etc/claude-code/managed-settings.d/k.json",
+    "k.json",
+    r#"{"permissions":{"deny":["Bash(dd:*)"]}}"#,
+);
+
+/// How the managed settings file or drop-in of the recorder's `effective_*` cases starts and goes on: a permission
+/// object at the root, then nested arrays under `disableFoo`, a member nothing reads. No other case outside an
+/// organization one holds it.
+const EFFECTIVE_START: &str = r#"{"permissions":{"#;
+const EFFECTIVE_MEMBER: &str = r#"]},"disableFoo":["#;
+
+/// Whether `document` is the managed document of an `effective_*` case.
+fn effective_document(document: &str) -> bool {
+    document.starts_with(EFFECTIVE_START) && document.contains(EFFECTIVE_MEMBER)
+}
+
+/// Where the fake host keeps the file each place of a case names, and the drop-in name it lists for it.
+fn place_path(place: &str) -> Option<(&'static str, Option<&'static str>)> {
+    match place {
+        "user" => Some(("/home/fixture/.claude/settings.json", None)),
+        "managed" => Some(("/etc/claude-code/managed-settings.json", None)),
+        "drop_a" => Some(("/etc/claude-code/managed-settings.d/a.json", Some("a.json"))),
+        "drop_b" => Some(("/etc/claude-code/managed-settings.d/b.json", Some("b.json"))),
+        _ => None,
+    }
+}
+
+/// The option each handed-over place fills: the parent process's managed settings and the remote managed settings.
+fn option_name(place: &str) -> Option<&'static str> {
+    match place {
+        "parent" => Some("managedSettings"),
+        "remote" => Some("serverManagedSettings"),
+        _ => None,
+    }
+}
+
+/// A root object holding, under `key`, `objects - 1` nested objects under `x`, then `arrays` nested arrays, then
+/// `inner` nested objects around `null`.
+fn text(objects: usize, arrays: usize, inner: usize, key: &str) -> String {
+    let opening = format!(
+        "{{\"{key}\":{}{}{}",
+        "{\"x\":".repeat(objects.saturating_sub(1)),
+        "[".repeat(arrays),
+        "{\"x\":".repeat(inner)
+    );
+    format!(
+        "{opening}null{}{}{}",
+        "}".repeat(inner),
+        "]".repeat(arrays),
+        "}".repeat(objects)
+    )
+}
+
+fn count(file: &Value, at: usize) -> Result<usize, &'static str> {
+    file[at]
+        .as_u64()
+        .and_then(|count| usize::try_from(count).ok())
+        .ok_or("a settings file has no count")
+}
+
+/// The text of one file of a case: `[place, text]`, `[place, objects, arrays, inner]` or the same with a root key.
+fn content(file: &Value) -> Result<String, Failure> {
+    match file.as_array().map(Vec::len) {
+        Some(2) => Ok(file[1].as_str().ok_or("a settings file has no text")?.to_owned()),
+        Some(4) => Ok(text(count(file, 1)?, count(file, 2)?, count(file, 3)?, "x")),
+        Some(5) => {
+            let key = file[4].as_str().ok_or("a settings file has no root key")?;
+            Ok(text(count(file, 1)?, count(file, 2)?, count(file, 3)?, key))
+        }
+        _ => Err("a settings file has an unknown shape".into()),
+    }
+}
+
+/// What `reg.exe` prints for the `Settings` value holding `document`, as the recorder writes it for its stand-in.
+fn registry_text(document: &str) -> String {
+    format!("\n    Settings    REG_SZ    {document}\n\n")
+}
+
+/// One case as the model runs it: its host and options, the drop-ins its host lists, and, for an organization case,
+/// the steps it runs after its first resolve.
+struct Case {
+    host: FakeHost,
+    options: ResolveSettingsOptions,
+    drop_ins: Vec<&'static str>,
+    organization: Option<Organization>,
+}
+
+/// The steps of an organization case after its first resolve, which differ only in the drop-in its second resolve
+/// finds.
+#[derive(Clone, Copy, Eq, PartialEq)]
+enum Organization {
+    Plain,
+    Kept,
+}
+
+/// The host and options of one case: the files it puts on disk, and the managed settings it hands over as options.
+/// A case holding a machine registry policy (`hklm`) is an organization case, which the recorder runs as root in an
+/// organization session with no settings sources, its stand-in for `reg.exe` answering that policy and no user one,
+/// under the WSL kernel from its first resolve on.
+///
+/// The recorder also runs its `effective_*` cases as an organization session (`CLAUDE_CODE_ENTRYPOINT` is
+/// `remote_cowork`), with the settings sources left as they are, one resolve per call, as a user who owns the managed
+/// documents it wrote. So `pE` upstream finds each of them rewritable (`n`): the first pass merges `{}` for it and the
+/// second only what `H7e` keeps of it (`m5`), never `disableFoo`, while the file cache (`Fu`) still copies the whole
+/// document in each evaluation. The fake host keeps no owners, so root, whose ids settle every write check, stands in
+/// for that user.
+fn case(files: &Value) -> Result<Case, Failure> {
+    let mut host = FakeHost::linux();
+    let mut drop_ins = Vec::new();
+    let mut options = Map::new();
+    let mut organization = None;
+    let mut effective = false;
+    for file in files.as_array().ok_or("a case has no files")? {
+        let place = file[0].as_str().ok_or("a settings file has no place")?;
+        if let Some(name) = option_name(place) {
+            let option =
+                crate::deep_json::parse_value(&content(file)?).ok_or("a managed settings option is not JSON")?;
+            options.insert(name.to_owned(), option);
+            continue;
+        }
+        if place == "hklm" {
+            let document = content(file)?;
+            organization = Some(if document.starts_with(KEPT_HELD_START) {
+                Organization::Kept
+            } else {
+                Organization::Plain
+            });
+            host = host
+                .variable(ORGANIZATION_ENTRYPOINT.0, ORGANIZATION_ENTRYPOINT.1)
+                .command(MACHINE_QUERY, ok(&registry_text(&document)))
+                .command(USER_QUERY, exited(1, REGISTRY_ABSENT))
+                .file(WSL_KERNEL.0, WSL_KERNEL.1);
+            host.root = true;
+            options.insert("settingSources".to_owned(), json!([]));
+            continue;
+        }
+        let (path, drop_in) = place_path(place).ok_or("a settings file has an unknown place")?;
+        let document = content(file)?;
+        effective |= place != "user" && effective_document(&document);
+        host = host.file(path, &document);
+        drop_ins.extend(drop_in);
+    }
+    if effective && organization.is_none() {
+        host = host.variable(ORGANIZATION_ENTRYPOINT.0, ORGANIZATION_ENTRYPOINT.1);
+        host.root = true;
+    }
+    if !drop_ins.is_empty() {
+        host = host.directory(DROP_INS, &drop_ins);
+    }
+    Ok(Case {
+        host,
+        options: serde_json::from_value(Value::Object(options))?,
+        drop_ins,
+        organization,
+    })
+}
+
+/// What one resolve answers, as the recorder prints it: the effective settings, the machine policy and the managed
+/// source printed by `JSON.stringify`, or the name and message of the error it rejects with when V8 runs out of
+/// stack or room. No case here holds a
+/// lone surrogate, so the well-formed print of the effective settings is the exact one.
+fn answer(host: &FakeHost, options: &ResolveSettingsOptions, state: &ResolverState) -> Result<Value, Failure> {
+    match resolve_settings_with_state(host, options, state) {
+        Ok(resolved) => {
+            let mut resolved = DeepJsonValue::encode(&resolved)?;
+            let effective = js_stringify(&resolved["effective"].take());
+            let machine_policy = js_stringify(&resolved["machinePolicy"].take());
+            let managed = resolved["sources"]
+                .as_array_mut()
+                .and_then(|sources| sources.iter_mut().find(|source| source["source"] == "managed"))
+                .map_or(Value::Null, Value::take);
+            Ok(json!({
+                "effective": effective,
+                "exact": effective,
+                "machine_policy": machine_policy,
+                "managed_source": js_stringify(&managed),
+                "error": null,
+            }))
+        }
+        Err(
+            error @ (ResolveSettingsError::MaximumCallStack
+            | ResolveSettingsError::InvalidArrayLength
+            | ResolveSettingsError::InvalidStringLength),
+        ) => Ok(rejected("RangeError", &error)),
+        Err(error @ ResolveSettingsError::InvalidRegularExpression) => Ok(rejected("SyntaxError", &error)),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// A rejection as the recorder prints it: no settings, and the error's name and message.
+fn rejected(name: &str, error: &ResolveSettingsError) -> Value {
+    json!({
+        "effective": null,
+        "exact": null,
+        "machine_policy": null,
+        "managed_source": null,
+        "error": {"name": name, "message": error.to_string()},
+    })
+}
+
+/// The causal stage of one process, as the recorder's catch log names it: the `catch` blocks that took a `RangeError`
+/// over every resolve the process ran, `read` for the settings file reader's and `drop_in` for the one around the
+/// drop-ins, then `rejected` when the last resolve rejected; `successful` when none of them happened.
+fn stage(caught: &[StackCatch], answered: &Value) -> String {
+    let sites: BTreeSet<&str> = caught
+        .iter()
+        .map(|site| match site {
+            StackCatch::Read => "read",
+            StackCatch::DropIn => "drop_in",
+        })
+        .collect();
+    let mut named: Vec<&str> = sites.into_iter().collect();
+    if !answered["error"].is_null() {
+        named.push("rejected");
+    }
+    if named.is_empty() {
+        "successful".to_owned()
+    } else {
+        named.join("+")
+    }
+}
+
+/// What `stack` answers for a recorded case at its call position, and its causal stage: a second call runs one
+/// resolve with the same options first, as a long-lived process does, and answers with the one after it. A resolve of
+/// an organization case that awaited a read of the machine policy goes on with `completion`, the stack of the I/O
+/// completion that read ended on, whatever its caller was.
+fn answer_at(files: &Value, call: &str, stack: NodeStack, completion: NodeStack) -> Result<(Value, String), Failure> {
+    let Case {
+        host,
+        options,
+        drop_ins,
+        organization,
+    } = case(files)?;
+    let _ = node_stack_catch::take();
+    let answered = match organization {
+        Some(organization) => organization_answer(host, &options, drop_ins, organization, call, (stack, completion))?,
+        None => {
+            let state = ResolverState::new().with_node_stack(stack);
+            match call {
+                "first" => answer(&host, &options, &state)?,
+                "second" => {
+                    answer(&host, &options, &state)?;
+                    answer(&host, &options, &state)?
+                }
+                _ => return Err("an answer names an unknown call position".into()),
+            }
+        }
+    };
+    let stage = stage(&node_stack_catch::take(), &answered);
+    Ok((answered, stage))
+}
+
+/// What an organization case answers. The recorder resolves it twice in one process, sharing every cache: once as the
+/// process starts, and once more `WSL_AT_MS` later, when the machine policy is read again. Both run under the WSL
+/// kernel, so the first read (`startLoad` upstream, `await(wq()??by())`) already runs the registry tool and parses
+/// the registry document outside any `catch`, where running out of stack rejects the resolve; the re-read of the
+/// second resolve (`o8`) catches the same failure and keeps the reading in force. Under WSL `_E` sets the registry
+/// policy aside unless the Windows side arms inheriting, so the managed file is the policy at both resolves. It
+/// prints one answer per resolve, each member listing them in order, or the `RangeError` alone once a resolve
+/// rejects, since nothing catches it there and the process ends. A second call first
+/// resolves with the same options before the first step and lets whatever that answers go, as the oracle's prime does.
+/// The machine policy re-reads run inline, so the fake clock alone decides when each one ends.
+///
+/// `resolveSettings` (`c8`) starts with `await o8()`, and `o8` awaits `net()`, the load `startLoad` keeps, then the
+/// re-read it starts when the reading in force is `ret` (1800000 ms) old. Under WSL that read runs `reg.exe` and
+/// `_E` awaits the stats of the registry tool (`await Promise.all([Mi,ZQe(Mi)].map(...YQe...))`) before it parses
+/// anything, so a resolve that read goes on from that I/O completion and not from its caller: the load of the first
+/// resolve of a process (the prime of a second call) and the re-read of the resolve `WSL_AT_MS` later. The resolve
+/// right after a prime finds the load settled and the reading fresh, reads nothing, and goes on from its caller.
+fn organization_answer(
+    host: FakeHost,
+    options: &ResolveSettingsOptions,
+    mut drop_ins: Vec<&'static str>,
+    organization: Organization,
+    call: &str,
+    (stack, completion): (NodeStack, NodeStack),
+) -> Result<Value, Failure> {
+    let state = ResolverState::with_rereads(PolicyRereads::Inline).with_node_stack(completion);
+    let state = match call {
+        "first" => state,
+        "second" => {
+            let _primed = answer(&host, options, &state);
+            state.with_node_stack(stack)
+        }
+        _ => return Err("an answer names an unknown call position".into()),
+    };
+    let first = answer(&host, options, &state)?;
+    if !first["error"].is_null() {
+        return Ok(first);
+    }
+    let mut later = host.at(WSL_AT_MS);
+    if organization == Organization::Kept {
+        drop_ins.push(KEPT_DROP_IN.1);
+        later = later
+            .file(KEPT_DROP_IN.0, KEPT_DROP_IN.2)
+            .directory(DROP_INS, &drop_ins);
+    }
+    let second = answer(&later, options, &state.with_node_stack(completion))?;
+    if !second["error"].is_null() {
+        return Ok(second);
+    }
+    let each = |member: &str| json!([first[member].clone(), second[member].clone()]);
+    Ok(json!({
+        "effective": each("effective"),
+        "exact": each("exact"),
+        "machine_policy": each("machine_policy"),
+        "managed_source": each("managed_source"),
+        "error": null,
+    }))
+}
+
+fn offset(value: &Value) -> Result<isize, &'static str> {
+    value
+        .as_i64()
+        .and_then(|offset| isize::try_from(offset).ok())
+        .ok_or("an offset is not a whole number")
+}
+
+/// The interval of offsets the refit measured for a host, call position and context.
+fn interval(answers: &Value, host: &str, call: &str, context: &str) -> Result<(isize, isize), Failure> {
+    let bounds = &answers["intervals"][host][call][context];
+    Ok((offset(&bounds[0])?, offset(&bounds[1])?))
+}
+
+/// The offset a row is checked at: the one offset of its context for a timer, an immediate or an I/O callback, and
+/// the offset the row names otherwise. It must lie inside the context's interval, on the grid.
+fn checked_offset(answers: &Value, row: &[Value], host: &str, call: &str, context: &str) -> Result<isize, Failure> {
+    let at = if SETTLED.contains(&context) {
+        offset(&answers["offsets"][host][call][context])?
+    } else {
+        offset(&row[7])?
+    };
+    let (low, high) = interval(answers, host, call, context)?;
+    if at < low || at > high || at % STEP != 0 {
+        return Err(format!("{host} {call} {context}: offset {at} is off the grid of [{low}, {high}]").into());
+    }
+    Ok(at)
+}
+
+/// Checks one row of the fixture: its offset, then the model's answer and stage there. A description of the row when
+/// the model answers otherwise, and the host, call position and context it covers.
+fn check(answers: &Value, row: &Value) -> Result<(Option<String>, (String, String, String)), Failure> {
+    let cases = answers["cases"].as_array().ok_or("the fixture has no cases")?;
+    let recorded = answers["answers"].as_array().ok_or("the fixture has no answers")?;
+    let row = row
+        .as_array()
+        .filter(|row| row.len() == 8)
+        .ok_or("a row is not a list of eight")?;
+    let host = row[0].as_str().ok_or("a row names no host")?;
+    let call = row[1].as_str().ok_or("a row names no call position")?;
+    let context = row[2].as_str().ok_or("a row names no context")?;
+    let (_, profile) = HOSTS
+        .iter()
+        .find(|(name, _)| *name == host)
+        .ok_or("a row names an unknown host")?;
+    if !CONTEXTS.contains(&context) {
+        return Err(format!("a row names an unknown context {context}").into());
+    }
+    let index = |at: usize| row[at].as_u64().and_then(|index| usize::try_from(index).ok());
+    let files = index(3).and_then(|at| cases.get(at)).ok_or("a row names no case")?;
+    let startup = index(4).ok_or("a row names no startup")?;
+    let expected = index(5)
+        .and_then(|at| recorded.get(at))
+        .ok_or("a row names no answer")?;
+    let at = checked_offset(answers, row, host, call, context)?;
+    let completion = offset(&answers["offsets"][host][call]["io"])?;
+    let stack = profile.with_startup_bytes(startup);
+    let (answered, stage) = answer_at(files, call, stack.resumed_by(at), stack.resumed_by(completion))?;
+    let stage_matches = row[6].as_str().is_none_or(|named| named == stage);
+    let unexplained = (answered != *expected || !stage_matches)
+        .then(|| format!("{host} {call} {context} case {} at {at}: {stage}", row[3]));
+    Ok((unexplained, (host.to_owned(), call.to_owned(), context.to_owned())))
+}
+
+/// Each answer recorded in every caller context is the model's answer for its case and call position, with the same
+/// catches, once the resolve has the room its context gives it on that host. The rows run on as many threads as the
+/// machine has, each with room for the deepest documents.
+#[test]
+fn each_answer_a_caller_context_gives_is_the_engine_at_its_offset() -> TestResult {
+    let answers: Value = serde_json::from_str(ANSWERS)?;
+    assert_eq!((&answers["node"], &answers["step"]), (&json!("v24.13.1"), &json!(STEP)));
+    let rows = answers["rows"].as_array().ok_or("the fixture has no rows")?;
+    let workers = thread::available_parallelism().map_or(1, usize::from);
+    let share = rows.len().div_ceil(workers).max(1);
+    let checked = thread::scope(|scope| -> Result<Vec<_>, Failure> {
+        let running = rows
+            .chunks(share)
+            .map(|chunk| {
+                let answers = &answers;
+                thread::Builder::new()
+                    .stack_size(DEEP_STACK_BYTES)
+                    .spawn_scoped(scope, move || -> Result<Vec<_>, Failure> {
+                        chunk.iter().map(|row| check(answers, row)).collect()
+                    })
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let mut checked = Vec::new();
+        for worker in running {
+            checked.extend(
+                worker
+                    .join()
+                    .map_err(|_| "a caller context answers worker panicked")??,
+            );
+        }
+        Ok(checked)
+    })?;
+    let contexts: BTreeSet<_> = checked.iter().map(|(_, covered)| covered).collect();
+    assert_eq!(
+        contexts.len(),
+        HOSTS.len() * 2 * CONTEXTS.len(),
+        "a host, call or context has no rows"
+    );
+    let unexplained: Vec<&String> = checked
+        .iter()
+        .filter_map(|(unexplained, _)| unexplained.as_ref())
+        .collect();
+    assert_eq!(unexplained, Vec::<&String>::new());
+    Ok(())
+}
