+//! The `catch` blocks of the TypeScript SDK that take a `RangeError` when a settings evaluation runs out of Node
+//! stack, and keep the evaluation going. Which of them caught decides what an answer at a given depth means, so the
+//! checks of what each depth answers note them; outside those checks noting one does nothing.
+
+/// A `catch` that takes the `RangeError` of running out of Node stack.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum StackCatch {
+    /// `Q7e` upstream, from the `catch` of the settings file reader: the file did not load.
+    Read,
+    /// The `catch` around the drop-ins in `um` upstream: the managed folder did not load, and keeps what merged before.
+    DropIn,
+}
+
+#[cfg(test)]
+thread_local! {
+    static CAUGHT: std::cell::RefCell<Vec<StackCatch>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Notes that `site` took a `RangeError` on this thread.
+pub(crate) fn note(site: StackCatch) {
+    #[cfg(test)]
+    CAUGHT.with(|caught| caught.borrow_mut().push(site));
+    #[cfg(not(test))]
+    let _ = site;
+}
+
+/// The catches noted on this thread since the last call, in order.
+#[cfg(test)]
+pub(crate) fn take() -> Vec<StackCatch> {
+    CAUGHT.with(|caught| caught.take())
+}
+
+/// The catches a thread noted while it ran an evaluation for another thread, to note again on the one that waits.
+pub(crate) struct Noted {
+    #[cfg(test)]
+    caught: Vec<StackCatch>,
+}
+
+impl Noted {
+    /// Runs `work`, and keeps what it noted.
+    pub(crate) fn during<T>(work: impl FnOnce() -> T) -> (T, Self) {
+        let value = work();
+        let noted = Self {
+            #[cfg(test)]
+            caught: take(),
+        };
+        (value, noted)
+    }
+
+    /// Notes them on this thread, after what it noted before.
+    pub(crate) fn again(self) {
+        #[cfg(test)]
+        CAUGHT.with(|caught| caught.borrow_mut().extend(self.caught));
+    }
+}
