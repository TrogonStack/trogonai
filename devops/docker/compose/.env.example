# --- Gateway ---
# TROGON_GATEWAY_PORT=8080
#
# Docker Compose mounts ./services/trogon-gateway/gateway.toml by default. That
# local config enables /sources/github/local/webhook with this secret. There is
# no default: every compose command fails until it is set, so no checkout runs
# the receiver on a secret everyone knows. Generate one with
# `openssl rand -hex 32`.
# TROGON_GATEWAY_LOCAL_GITHUB_WEBHOOK_SECRET=
#
# Secret fields can reference environment variables from TOML, for example:
# webhook_secret = { env = "GITHUB_ACME_MAIN_WEBHOOK_SECRET" }
# bot_token = { env = "DISCORD_BOT_TOKEN" }

# --- OpenBao ---
# The compose stack runs a postgres-backed OpenBao that openbao-bootstrap
# initializes with this fixed root token (see services/openbao/README.md).
# Use it for local copy-in/copy-out checks and ignored integration tests.
OPENBAO_DEV_ROOT_TOKEN=local-dev-root-token
# Host access with OrbStack:
# OPENBAO_ADDR=http://openbao.trogonai.orb.local:8200
# OPENBAO_TOKEN=local-dev-root-token
# The local OpenBao serves plain HTTP, which the gateway refuses unless allowed.
# OPENBAO_ALLOW_PLAINTEXT=true
#
# --- Credential management ---
# Enables the internal /-/credentials API. Local examples use this token through
# the x-trogon-admin-token header.
# TROGON_GATEWAY_CREDENTIAL_MANAGEMENT_ADMIN_TOKEN=local-admin-token
#
# Enable runtime OpenBao credential resolution per source as needed.
# TROGON_GATEWAY_ENABLE_RUNTIME_DISCORD_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_GITHUB_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_GITLAB_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_INCIDENTIO_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_LINEAR_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_MICROSOFT_GRAPH_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_NOTION_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_SENTRY_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_SLACK_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_TELEGRAM_CREDENTIALS=true
# TROGON_GATEWAY_ENABLE_RUNTIME_TWITTER_CREDENTIALS=true

# --- NATS ---
# The server accepts only TLS with a client certificate from the dev CA plus an
# nsc creds file, the way a deployment does (devops/nats/README.md). The first
# `up` generates all of it into the dev_secrets volume, and compose hands each
# client container its own NATS_URL, NATS_CREDS, NATS_CA, NATS_CERT and
# NATS_KEY, so none of them belong in this file.
#
# The port is published on 127.0.0.1 only.
# NATS_PORT=4222
#
# A process on the host connects as the PLATFORM developer identity. Copy its
# files out of the volume into tmp/, which git ignores:
#   docker compose --profile tools run --rm -v ./tmp/nats:/export nats-box \
#     sh -c 'cp /run/secrets/nats/* /export/'
# then point it at them by absolute path:
# NATS_URL=tls://localhost:4222
# NATS_CREDS=/path/to/devops/docker/compose/tmp/nats/nats.creds
# NATS_CA=/path/to/devops/docker/compose/tmp/nats/ca.pem
# NATS_CERT=/path/to/devops/docker/compose/tmp/nats/client.pem
# NATS_KEY=/path/to/devops/docker/compose/tmp/nats/client-key.pem

# --- GitHub Source ---
# GITHUB_PRIMARY_WEBHOOK_SECRET=

# --- GitLab Source ---
# GITLAB_PRIMARY_SIGNING_TOKEN=

# --- incident.io Source ---
# INCIDENTIO_PRIMARY_SIGNING_SECRET=whsec_...

# --- Linear Source ---
# LINEAR_PRIMARY_WEBHOOK_SECRET=

# --- Microsoft Graph Change Notifications Source ---
# MICROSOFT_GRAPH_PRIMARY_CLIENT_STATE=

# --- Notion Source ---
# NOTION_PRIMARY_VERIFICATION_TOKEN=

# --- Sentry Source ---
# SENTRY_PRIMARY_CLIENT_SECRET=

# --- Datadog Source ---
# DATADOG_PRIMARY_WEBHOOK_TOKEN=

# --- Zoom Source ---
# ZOOM_PRIMARY_SECRET_TOKEN=

# --- Discord Source ---
# DISCORD_BOT_TOKEN=

# --- Telegram Source ---
# TELEGRAM_PRIMARY_WEBHOOK_SECRET=
# TELEGRAM_PRIMARY_BOT_TOKEN=

# --- Twitter/X Source ---
# TWITTER_PRIMARY_CONSUMER_SECRET=

# --- Slack Source ---
# SLACK_PRIMARY_SIGNING_SECRET=
# SLACK_PRIMARY_APP_TOKEN=

# --- Postgres ---
# Network clients must use TLS; services/postgres/pg_hba.conf rejects plaintext.
# Containers verify the server with sslmode=verify-full against the dev CA,
# mounted from the ca/ directory of the dev_secrets volume, as openbao does.
# POSTGRES_USER=trogon
# POSTGRES_PASSWORD=trogon
# POSTGRES_DB=trogon_scheduler
# POSTGRES_PORT=5432

# --- OpenBao (local dev only) ---
# OPENBAO_POSTGRES_DB=openbao
# OPENBAO_DEV_ROOT_TOKEN=local-dev-root-token
# OPENBAO_DEV_TRANSIT_MOUNT=transit
# OPENBAO_DEV_TRANSIT_KEY=local-dev-kek
# OPENBAO_DEV_KV_MOUNT=secret
# OPENBAO_LOG_LEVEL=info
# Base64 of exactly 32 bytes (`openssl rand -base64 32`). This throwaway default
# is what compose falls back to; a deployment holding real key material needs a
# real seal, not this one. Changing it on an initialized database leaves the
# server unable to decrypt its own root key, so reset with `down -v` if you do.
# OPENBAO_STATIC_SEAL_KEY=bG9jYWwtZGV2LW9ubHktc2VhbC1rZXktMzJieXRlcyE=

# --- Logging ---
# RUST_LOG=info

# --- Dev (ngrok tunnels) ---
# NGROK_AUTHTOKEN=
