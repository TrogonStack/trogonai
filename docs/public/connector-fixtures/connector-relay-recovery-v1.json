          "expected": "REPLAY"
        },
        {
          "op": "send_intent",
          "worker": "worker-a",
          "expected": "PHASE_REJECTED"
        },
        {
          "op": "accept_audit",
          "worker": "worker-a",
          "expected": "AUDITED"
        },
        {
          "op": "send_intent",
          "worker": "worker-a",
          "expected": "SEND_INTENT"
        },
        {
          "op": "send",
          "worker": "worker-a",
          "expected": "PROVIDER_SENT"
        },
        {
          "op": "send",
          "worker": "worker-a",
          "expected": "NO_SEND_PERMIT"
        },
        {
          "op": "complete",
          "worker": "worker-a",
          "expected": "COMPLETED"
        },
