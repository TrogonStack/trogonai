{
  "profile": "connector-relay-recovery-v1",
  "notice": "Selected deterministic reference-state traces, not proof of atomic distributed claims, store durability, audit-adapter deduplication or running HTTP effects. Provider sends are counted separately from body-free audit/outbox publication. Fresh-grant switching archives old terminal receipts instead of restoring their authority. Capacity traces use explicit synthetic reserved metadata charges and lower operator limits; real adapters must account actual bytes and share durable reservations across every replica.",
  "sources": [
    "docs/reference/connector-relay-recovery.md",
    "https://www.rfc-editor.org/rfc/rfc9110.html#section-9.2.2",
    "https://docs.nats.io/using-nats/developer/develop_jetstream/model_deep_dive"
  ],
  "constants": {
    "replay_safety_margin_seconds": 60,
    "maximum_completion_slots_per_tenant": 1024,
    "maximum_completion_metadata_bytes_per_tenant": 8388608,
    "maximum_undelivered_completion_age_seconds": 60
  },
  "traces": [
