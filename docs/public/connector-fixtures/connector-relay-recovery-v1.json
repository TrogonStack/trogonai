          "worker": "worker-b",
          "epoch": 1,
          "expected": "EPOCH_MISMATCH"
        },
        {
          "op": "renew",
          "expires_at": 200,
          "epoch": 1,
          "expected": "GRANT_CLOSED"
        },
        {
          "op": "fresh_grant",
          "grant_id": "fixture-grant",
          "key_id": "fixture-key",
          "epoch": 2,
          "expires_at": 300,
          "expected": "FRESH_AUTHORITY_REQUIRED"
        },
        {
          "op": "fresh_grant",
          "grant_id": "fixture-grant-new",
          "key_id": "fixture-key-new",
          "epoch": 2,
          "expires_at": 300,
          "expected": "RECOVERY_REQUIRED"
        },
        {
          "op": "recover",
          "expected": "OUTCOME_UNKNOWN"
        },
        {
          "op": "publish_completion",
          "expected": "COMPLETION_RECORDED"
        },
        {
          "op": "fresh_grant",
          "grant_id": "fixture-grant-new",
          "key_id": "fixture-key-new",
          "epoch": 2,
          "expires_at": 300,
          "expected": "FRESH_GRANT_INSTALLED"
        },
        {
          "op": "claim",
          "invocation": "request-new",
          "worker": "worker-b",
          "grant_id": "fixture-grant-new",
          "key_id": "fixture-key",
          "epoch": 2,
          "expected": "KEY_MISMATCH"
        },
        {
          "op": "claim",
          "invocation": "request-new",
          "worker": "worker-b",
          "grant_id": "fixture-grant",
          "key_id": "fixture-key",
          "epoch": 2,
          "expected": "GRANT_MISMATCH"
        },
        {
          "op": "claim",
          "invocation": "request-new",
          "worker": "worker-b",
          "grant_id": "fixture-grant-new",
          "key_id": "fixture-key-new",
          "epoch": 2,
          "expected": "CLAIMED"
        }
      ],
