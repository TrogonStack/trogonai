        {
          "op": "renew",
          "expires_at": 200,
          "now": 50,
          "expected": "RENEWED"
        },
        {
          "op": "expire",
          "now": 100,
          "expected": "NOT_EXPIRED"
        },
        {
          "op": "prune",
