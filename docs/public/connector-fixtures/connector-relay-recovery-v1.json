        },
        {
          "op": "claim",
          "worker": "worker-b",
          "now": 161,
          "expected": "REPLAY"
        },
        {
          "op": "revoke",
          "now": 180,
          "expected": "GRANT_CLOSED"
        },
        {
          "op": "renew",
          "expires_at": 300,
          "now": 180,
          "expected": "GRANT_CLOSED"
        },
        {
          "op": "prune",
          "now": 259,
          "expected": "RETENTION_REQUIRED"
        },
        {
