{
  "profile": "trogon/connector-mcp-authorization/v1",
  "authorization_revision": "2026-07-28",
  "notice": "Synthetic normative conformance inputs and expected component decisions for future real client tests. All identifiers, callback values and hosts are fixtures. JSON parsing and reference expectation checks do not prove OAuth, callback ordering, HTTP behavior or runtime security.",
  "rules": {
    "scope_ceiling_meaning": "effective intersection of current release, ProviderApp, owner authority and product policy",
    "scope_tokens": "exact, case-sensitive; sorted unique candidates",
    "callback_prerequisite": "session, initiator and single-use state checks must pass independently",
    "issuer_decode": "application/x-www-form-urlencoded once, strict UTF-8, no URI normalization",
    "offline_cases_are_component_decisions": "omitting offline_access alone does not authorize the rest of a product flow",
    "registration_uncertainty": "no blind retry of an ambiguous registration POST",
    "revision_scope": "authorization is pinned separately from transport and session behavior",
    "client_material_issuer": "issuer of any client material proposed for reuse; null means no existing material is proposed"
  },
  "sources": [
    "https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization",
    "https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization/client-registration",
    "https://www.rfc-editor.org/rfc/rfc9207.html",
    "https://openid.net/specs/openid-connect-core-1_0.html#OfflineAccess"
  ],
