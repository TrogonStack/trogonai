{
  "templates": {
    "snapshot": {
      "type": "trogonai.platform.workload_identity.v1alpha1.RegistrationSnapshot",
      "payload": {
        "tenant": "tenant_1",
        "project": "project_1",
        "recoveryFence": "1",
        "registrationRevision": "2",
        "trustRevision": "3",
        "issuedAt": "2030-01-01T00:00:00Z",
        "expiresAt": "2030-01-01T00:05:00Z",
        "bindings": [
          {
            "spiffeId": "spiffe://example.test/proxy",
            "tenant": "tenant_1",
            "project": "project_1",
            "role": 1
          }
        ],
        "approvedRootSha256": [
          "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
        ]
      }
    },
    "activation": {
      "type": "trogonai.platform.workload_identity.v1alpha1.CredentialActivation",
      "payload": {
        "binding": {
          "spiffeId": "spiffe://example.test/proxy",
          "tenant": "tenant_1",
          "project": "project_1",
          "role": 1
        },
        "recoveryFence": "1",
        "registrationRevision": "2",
        "trustRevision": "3",
        "sourceRevision": "4",
        "activationRevision": "4",
        "leafSha256": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
        "publicKeySha256": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
        "bundleSha256": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
        "notBefore": "2030-01-01T00:00:00Z",
        "expiresAt": "2030-01-01T01:00:00Z"
      }
    }
  },
  "cases": [
    {
      "name": "finite registration snapshot",
      "template": "snapshot",
      "violations": []
    },
    {
      "name": "bounded activation intent",
      "template": "activation",
      "violations": []
    },
    {
      "name": "registration cannot cross tenant",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings/0/tenant",
          "value": "tenant_2"
        }
      ],
      "violations": [
        "every registration belongs to this exact tenant and project"
      ]
    },
    {
      "name": "agent requires application identity",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings/0/role",
          "value": 2
        }
      ],
      "violations": [
        "only an agent registration has an application identity"
      ]
    },
    {
      "name": "registration cannot lease past backstop",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/expiresAt",
          "value": "2030-01-01T00:05:31Z"
        }
      ],
      "violations": [
        "registration authority has a positive lease no longer than 330 seconds"
      ]
    },
    {
      "name": "activation cannot exceed one hour",
      "template": "activation",
      "patch": [
        {
          "op": "replace",
          "path": "/expiresAt",
          "value": "2030-01-01T01:00:01Z"
        }
      ],
      "violations": [
        "an SVID has positive validity no longer than one hour"
      ]
    },
    {
      "name": "activation requires exact fingerprint",
      "template": "activation",
      "patch": [
        {
          "op": "replace",
          "path": "/leafSha256",
          "value": "AA=="
        }
      ],
      "violations": [
        "must be 32 bytes"
      ]
    },
    {
      "name": "registration requires approved roots",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/approvedRootSha256",
          "value": []
        }
      ],
      "violations": [
        "must contain at least 1 item(s)"
      ]
    }
  ]
}
