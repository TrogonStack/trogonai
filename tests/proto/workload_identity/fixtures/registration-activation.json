  "cases": [
    {
      "name": "finite registration snapshot",
      "template": "snapshot",
      "violations": []
    },
    {
      "name": "bounded activation intent",
      "template": "activation",
      "violations": []
    },
    {
      "name": "registration cannot cross tenant",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings/0/tenant",
          "value": "tenant_2"
        }
      ],
      "violations": [
        "every registration belongs to this exact tenant and project"
      ]
    },
    {
      "name": "agent requires application identity",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings/0/role",
          "value": 2
        }
      ],
      "violations": [
        "only an agent registration has an application identity"
      ]
    },
    {
      "name": "registration cannot lease past backstop",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/expiresAt",
          "value": "2030-01-01T00:05:31Z"
        }
      ],
      "violations": [
        "registration authority has a positive lease no longer than 330 seconds"
      ]
    },
    {
      "name": "activation cannot exceed one hour",
      "template": "activation",
      "patch": [
        {
          "op": "replace",
          "path": "/expiresAt",
          "value": "2030-01-01T01:00:01Z"
        }
      ],
      "violations": [
        "an SVID has positive validity no longer than one hour"
      ]
    },
    {
      "name": "activation requires exact fingerprint",
      "template": "activation",
      "patch": [
        {
          "op": "replace",
          "path": "/leafSha256",
          "value": "AA=="
        }
      ],
      "violations": [
        "must be 32 bytes"
      ]
    },
    {
      "name": "registration requires approved roots",
      "template": "snapshot",
      "patch": [
        {
          "op": "replace",
          "path": "/approvedRootSha256",
          "value": []
        }
      ],
      "violations": [
        "must contain at least 1 item(s)"
      ]
    },
    {
      "name": "activation audit is must before effect",
      "template": "audit"
    },
    {
      "name": "activation audit cannot be best effort",
      "template": "audit",
      "patch": [
        {
          "op": "replace",
          "path": "/class",
          "value": 2
        }
      ],
      "violations": [
        "credential activation is must-audit under its exact registered scope"
      ]
    },
    {
      "name": "activation audit cannot change tenant",
      "template": "audit",
      "patch": [
        {
          "op": "replace",
          "path": "/tenant/value",
          "value": "tenant_2"
        }
      ],
      "violations": [
        "credential activation is must-audit under its exact registered scope"
      ]
    }
  ]
}
