{
  "templates": {
    "completion-success": {
      "type": "trogonai.workflows.runs.v1alpha1.NodeCompletion",
      "payload": {
        "completionId": "completion-example",
        "occurrenceId": "occurrence-example",
        "evidence": [
          {
            "invocationReceiptId": "receipt-example"
          }
        ],
        "completionCondition": {
          "evaluationId": "evaluation-positive",
          "condition": {
            "always": {}
          },
          "inputs": [],
          "result": true
        },
        "succeeded": {
          "outputs": []
        }
      }
    },
    "completion-business-rejection": {
      "type": "trogonai.workflows.runs.v1alpha1.NodeCompletion",
      "payload": {
        "completionId": "completion-rejected",
        "occurrenceId": "occurrence-example",
        "evidence": [
          {
            "invocationReceiptId": "receipt-example"
          }
        ],
        "rejected": {
          "outputs": [
            {
              "name": "verdict",
              "value": {
                "symbolValue": {
                  "typeName": "review.verdict",
                  "value": "changes_requested"
                }
              }
            }
          ],
          "acceptance": {
            "evaluationId": "evaluation-negative",
            "condition": {
              "compare": {
                "left": {
                  "literal": {
                    "boolValue": false
                  }
                },
                "operator": "COMPARISON_OPERATOR_EQUAL",
                "right": {
                  "literal": {
                    "boolValue": true
                  }
                }
              }
            },
            "inputs": [],
            "result": false
          }
        }
      }
    },
    "sequence-advance-after-completed-child": {
      "type": "trogonai.workflows.runs.v1alpha1.SequenceDecision",
      "payload": {
        "completedOccurrenceIds": [
          "occurrence-previous"
        ],
        "advance": {
          "nextNode": {
            "nodeId": "review"
          },
          "nextPosition": 1
        }
      }
    },
    "join-completed": {
      "type": "trogonai.workflows.runs.v1alpha1.JoinDecision",
