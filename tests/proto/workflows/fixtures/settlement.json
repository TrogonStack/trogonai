          "op": "replace",
          "path": "/subscriptions/0",
          "value": {
            "waitId": "wait-example",
            "activationId": "activation-example",
            "unreconciled": {
              "detail": "Awaiting cleanup evidence."
            }
          }
        }
      ],
      "violations": [
        "accepted and rejected completion require determinate effects"
      ]
    },
    {
      "name": "termination-rejects-duplicate-subscription-settlement",
