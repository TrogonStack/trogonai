  "cases": [
    {
      "name": "receipt-matching-artifact-source",
      "template": "receipt-matching-artifact-source"
    },
    {
      "name": "receipt-rejects-artifact-from-another-session",
      "template": "receipt-matching-artifact-source",
      "patch": [
        {
          "op": "replace",
          "path": "/succeeded/artifacts/0/recordedAt/session/sessionId",
          "value": "session-other"
