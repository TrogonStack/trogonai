  "cases": [
    {
      "name": "command-provision-definition",
      "template": "command-provision-definition"
    },
    {
      "name": "command-provision-rejects-empty-definition",
      "template": "command-provision-definition",
      "patch": [
        {
          "op": "replace",
          "path": "/definitionBytes",
          "value": ""
        }
      ],
      "violations": [
        "must be at least 1 bytes"
      ]
    },
    {
      "name": "event-definition-provisioned",
      "template": "event-definition-provisioned"
    },
    {
      "name": "event-provisioning-rejects-nongenesis-revision",
      "template": "event-definition-provisioned",
      "patch": [
        {
          "op": "replace",
          "path": "/workflowDefinitionProvisioned/definition/reference/revision",
          "value": "2"
        }
      ],
      "violations": [
        "provisioning must mint revision 1"
      ]
    },
    {
      "name": "event-definition-requires-known-arm",
      "template": "event-definition-provisioned",
      "patch": [
