    {
      "name": "entry-revoke metadata-only contract",
      "template": "entry-revoke"
    },
    {
      "name": "metadata validation cannot claim another source",
      "template": "reg",
      "patch": [
        {
          "op": "replace",
          "path": "/metadataValidationRef/sourceRef/sourceId/value",
          "value": "source_2"
        }
      ],
      "violations": [
        "metadata validation must name the exact source definition"
      ]
    },
    {
      "name": "returned SecretRefs cannot be reused for another entry",
      "template": "reg",
      "patch": [
        {
          "op": "add",
          "path": "/bindings/1",
          "value": {
            "entryId": {
              "value": "entry_2"
            },
            "secretRef": {
              "id": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
            }
          }
        }
      ],
      "violations": [
        "source entries and returned SecretRefs must be unique"
      ]
    },
    {
      "name": "registered entry IDs cannot repeat under different refs",
      "template": "reg",
      "patch": [
        {
          "op": "add",
          "path": "/bindings/1",
          "value": {
            "entryId": {
              "value": "entry_1"
            },
            "secretRef": {
              "id": "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
            }
          }
        }
      ],
      "violations": [
        "source entries and returned SecretRefs must be unique"
      ]
    },
    {
      "name": "metadata cannot expose provider-shaped SecretRef",
      "template": "reg",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings/0/secretRef/id",
          "value": "openbao:customer/path"
        }
      ],
      "violations": [
        "does not match regex pattern"
      ]
    },
    {
      "name": "source state cannot retarget immutable entry reference",
      "template": "state",
      "patch": [
        {
          "op": "replace",
          "path": "/entries/0/binding/secretRef",
          "value": {
            "id": "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
          }
        }
      ],
      "violations": [
        "source state must retain exactly its registered immutable entry bindings"
      ]
    },
    {
      "name": "source revocation must retain all entries as revoked",
      "template": "state",
      "patch": [
        {
          "op": "replace",
          "path": "/lifecycle",
          "value": 2
        }
      ],
      "violations": [
        "a revoked source must retain every entry as revoked"
      ]
    },
    {
      "name": "terminal source state keeps original immutable references",
      "template": "revoked"
    },
    {
      "name": "revocation reason cannot be unspecified",
      "template": "source-revoke",
      "patch": [
        {
          "op": "replace",
          "path": "/reason",
          "value": 0
        }
      ],
      "violations": [
        "must not be in"
      ]
    }
  ]
