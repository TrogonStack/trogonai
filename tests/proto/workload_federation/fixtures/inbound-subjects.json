    {
      "name": "inbound/inbound SPIFFE domain substitution refused",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/spiffe/spiffeId",
          "value": "spiffe://other.test/worker"
        }
      ],
      "violations": [
        "SPIFFE subject must belong to its exact declared trust domain"
      ]
    },
    {
      "name": "inbound/inbound trust cannot cross tenant",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/trustRegistrationRef/scope/tenant",
          "value": "tenant_2"
        }
      ],
      "violations": [
        "subject binding and trust registration must have the same scope"
      ]
    },
    {
      "name": "inbound/inbound binding reference cannot cross project",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/subjectBindingRef/scope/project",
          "value": "project_2"
        }
      ],
      "violations": [
        "subject binding reference and definition must have the same scope"
      ]
    },
    {
      "name": "inbound/inbound principal cannot be empty",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/principalId/value",
          "value": ""
        }
      ],
      "violations": [
        "does not match regex pattern"
      ]
    },
    {
      "name": "inbound/inbound operations cannot be empty",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/permittedOperationIds",
          "value": []
        }
      ],
      "violations": [
        "must contain at least 1 item"
      ]
    },
    {
      "name": "inbound/native SPIFFE does not invent a replay claim",
      "template": "spiffe",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/replay",
          "value": {
            "oneTimeIdentifierClaim": "jti"
          }
        }
      ],
      "violations": [
        "native SPIFFE admission cannot use an OIDC replay identifier"
      ]
    },
    {
      "name": "inbound/inbound wildcard subject refused",
      "template": "oidc",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/oidc/subject",
          "value": "*"
        }
      ],
      "violations": [
        "must not be in list"
      ]
    },
    {
      "name": "inbound/inbound wildcard claim value refused",
      "template": "oidc",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/oidc/claims/0/values",
          "value": [
            "*"
          ]
        }
      ],
      "violations": [
        "must not be in list"
      ]
    },
    {
      "name": "inbound/inbound issuer cannot be overridden as extra claim",
      "template": "oidc",
      "patch": [
        {
          "op": "replace",
          "path": "/definition/oidc/claims/0/claim",
          "value": "iss"
        }
      ],
      "violations": [
        "must not be in list"
      ]
    },
    {
      "name": "inbound/GitHub immutable repository id required",
