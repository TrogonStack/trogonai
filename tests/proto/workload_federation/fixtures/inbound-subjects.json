      "patch": [
        {
          "op": "replace",
          "path": "/definition/oidc/githubActions/reusableWorkflow/jobWorkflowSha",
          "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ],
