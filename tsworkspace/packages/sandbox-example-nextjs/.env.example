# Copy to .env.local. Values are never committed.

# Sandbox gateway (ignored when SANDBOX_PROVIDER=memory)
SANDBOX_GATEWAY_HTTP_URL=
SANDBOX_GATEWAY_WS_URL=
SANDBOX_API_KEY=
SANDBOX_TENANT=

# Set to "memory" to use the in-process fake instead of a gateway
SANDBOX_PROVIDER=local_docker

# Bearer token the reaper route requires from its caller (the cron job)
CRON_SECRET=
