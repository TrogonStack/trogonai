load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm_tsworkspace//:defs.bzl", "npm_link_all_packages")
load("@npm_tsworkspace//tsworkspace:oxlint/package_json.bzl", oxlint_bin = "bin")
load("@npm_tsworkspace//tsworkspace/packages/sandbox-cli:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

js_library(name = "package_metadata", srcs = ["package.json"])

filegroup(name = "sources", srcs = glob(["src/**/*.ts"]))
filegroup(name = "unit_tests", srcs = glob(["tests/**/*.test.ts"]))

ts_project(
    name = "build",
    srcs = [":sources"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    root_dir = "src",
    source_map = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":node_modules", ":package_metadata"],
)

ts_project(
    name = "typecheck",
    srcs = ["vitest.config.ts", ":sources", ":unit_tests"],
    declaration = True,
    declaration_map = True,
    extends = "tsconfig.json",
    no_emit = True,
    out_dir = "dist",
    resolve_json_module = True,
    root_dir = ".",
    source_map = True,
    tsconfig = "tsconfig.typecheck.json",
    deps = [":node_modules", ":package_metadata"],
)

js_library(
    name = "test_inputs",
    srcs = ["package.json", "vitest.config.ts", ":sources", ":unit_tests"],
)

vitest_bin.vitest_test(
    name = "test",
    args = ["run", "--coverage"],
    chdir = package_name(),
    copy_data_to_bin = False,
    data = [":node_modules", ":test_inputs", "//tsworkspace:node_modules/vitest"],
    env = {"VITEST_MAX_WORKERS": "4", "VITE_ALLOW_OUTSIDE_ROOT": "1", "VITE_BAZEL_RUNFILES": "1"},
    patch_node_fs = False,
    tags = ["cpu:4"],
)

oxlint_bin.oxlint_test(
    name = "lint",
    args = ["--deny-warnings", "."],
    chdir = package_name(),
    data = ["vitest.config.ts", ":sources", ":unit_tests"],
)

npm_package(
    name = "pkg",
    srcs = ["README.md", "package.json", ":build", ":build_types"],
    package = "@trogonai/sandbox-cli",
    visibility = ["//visibility:public"],
)

js_library(
    name = "fmt_inputs",
    srcs = glob(["**/*.json", "**/*.mjs", "**/*.ts", "**/*.yaml"], allow_empty = True, exclude = ["coverage/**", "dist/**"]),
    visibility = ["//tsworkspace:__pkg__"],
)
