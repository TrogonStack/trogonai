# Copy to .env.local. Values are never committed.

# Sandbox gateway (ignored when SANDBOX_PROVIDER=memory)
SANDBOX_GATEWAY_HTTP_URL=
SANDBOX_GATEWAY_WS_URL=
SANDBOX_API_KEY=
SANDBOX_TENANT=

# This example uses a Docker Node image. Set "memory" for the in-process fake.
SANDBOX_PROVIDER=local_docker

# Model: required. A model id served by the OpenAI-compatible endpoint below, or "scripted" for no endpoint or key
SANDBOX_EXAMPLE_MODEL=
SANDBOX_EXAMPLE_MODEL_BASE_URL=
SANDBOX_EXAMPLE_MODEL_API_KEY=
