load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm_tsworkspace//:defs.bzl", "npm_link_all_packages")
load("@npm_tsworkspace//tsworkspace:oxlint/package_json.bzl", oxlint_bin = "bin")
load("@npm_tsworkspace//tsworkspace/packages/proto:@bufbuild/protoc-gen-es/package_json.bzl", protoc_gen_es_bin = "bin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.ts"]),
)

# Everything `mise run proto:generate-key-custody-typescript` writes to.
filegroup(
    name = "generated",
    srcs = glob(["src/gen/**"]),
)

# The package exports its TypeScript source directly, so the source is the
# package: consumers resolve @trogonai/proto to these files.
npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":sources",
    ],
    package = "@trogonai/proto",
    visibility = ["//tsworkspace:__subpackages__"],
)

ts_project(
    name = "typecheck",
    srcs = [":sources"],
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = [":node_modules/@bufbuild/protobuf"],
)

oxlint_bin.oxlint_test(
    name = "lint",
    args = ["."],
    chdir = package_name(),
    data = [
        ".oxlintrc.json",
        ":sources",
    ],
)

# Every file oxfmt formats, for the format check in //tsworkspace. A js_library
# copies them into the output tree in this package, which the js_test there
# requires of files that live outside its own package.
js_library(
    name = "fmt_inputs",
    srcs = glob(
        [
            "**/*.css",
            "**/*.html",
            "**/*.json",
            "**/*.ts",
            "**/*.tsx",
            "**/*.yaml",
        ],
        allow_empty = True,
        exclude = [
            "coverage/**",
            "dist/**",
        ],
    ),
    visibility = ["//tsworkspace:__pkg__"],
)

protoc_gen_es_bin.protoc_gen_es_binary(
    name = "protoc_gen_es",
)

# Regenerates the key custody bindings the way
# `mise run proto:generate-key-custody-typescript` does and fails when any file
# under src/gen differs from the committed tree.
sh_test(
    name = "key_custody_generated_test",
    srcs = ["//proto:buf_test.sh"],
    args = [
        "$(rootpath //.config/bazel:buf)",
        "$(rootpath //proto:buf_cache)",
        "typescript",
        package_name(),
        "$(rootpath :protoc_gen_es)",
        "--",
        "$(rootpaths //:buf.lock)",
        "$(rootpaths //:buf.yaml)",
        "$(rootpaths //proto:sources)",
        "$(rootpaths buf.key-custody.gen.yaml)",
        "$(rootpaths generate-key-custody.sh)",
        "$(rootpaths :generated)",
    ],
    data = [
        "buf.key-custody.gen.yaml",
        "generate-key-custody.sh",
        ":generated",
        ":protoc_gen_es",
        "//.config/bazel:buf",
        "//:buf.lock",
        "//:buf.yaml",
        "//proto:buf_cache",
        "//proto:sources",
    ],
)
