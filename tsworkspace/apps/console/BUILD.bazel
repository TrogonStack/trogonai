load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm_tsworkspace//:defs.bzl", "npm_link_all_packages")
load("@npm_tsworkspace//tsworkspace:oxlint/package_json.bzl", oxlint_bin = "bin")
load("@npm_tsworkspace//tsworkspace/apps/console:@tanstack/router-cli/package_json.bzl", router_cli_bin = "bin")
load("@npm_tsworkspace//tsworkspace/apps/console:vite/package_json.bzl", vite_bin = "bin")
load("@npm_tsworkspace//tsworkspace/apps/console:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "sources",
    srcs = glob(
        ["src/**"],
        exclude = ["src/routeTree.gen.ts"],
    ),
)

# Everything vite reads besides src/: the entry document, static assets and
# the tool configuration.
filegroup(
    name = "app_config",
    srcs = [
        "components.json",
        "index.html",
        "package.json",
        "tsconfig.json",
        "tsr.config.json",
        "vite.config.ts",
    ] + glob(["public/**"]),
)

router_cli_bin.tsr_binary(name = "tsr")

# Route generation as a declared step. routeTree.gen.ts is gitignored, so
# Bazel produces it instead of relying on a developer having run tsr.
js_run_binary(
    name = "routes",
    srcs = [
        "package.json",
        "tsr.config.json",
        ":node_modules",
        ":sources",
    ],
    args = ["generate"],
    chdir = package_name(),
    outs = ["src/routeTree.gen.ts"],
    tool = ":tsr",
)

ts_project(
    name = "typecheck",
    srcs = [
        "vite.config.ts",
        ":routes",
        ":sources",
    ],
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules",
        "//tsworkspace:node_modules/@types/react",
        "//tsworkspace:node_modules/vitest",
    ],
)

# The production build, as a single tree artifact.
vite_bin.vite(
    name = "build",
    srcs = [
        ":app_config",
        ":node_modules",
        ":routes",
        ":sources",
    ],
    args = ["build"],
    chdir = package_name(),
    # Rolldown resolves index.html through its sandbox symlink to the real
    # execroot path and then rejects the resulting relative asset name, so
    # the build runs outside the sandbox where the two paths agree.
    execution_requirements = {"no-sandbox": "1"},
    out_dirs = ["dist"],
)

# Shared input copies must not inherit the test action's CPU reservation.
js_library(
    name = "test_inputs",
    srcs = [
        ":app_config",
        ":routes",
        ":sources",
    ],
)

# CI-only control: an undeclared test file in the canonical output tree.
copy_file(
    name = "undeclared_sibling",
    src = "control/undeclared-sibling.txt",
    out = "src/screens/declared1.test.tsx",
)

# Builds the sibling before the test without making it a test input.
copy_file(
    name = "undeclared_sibling_order",
    src = ":undeclared_sibling",
    out = "undeclared-sibling-order.txt",
)

vitest_bin.vitest_test(
    name = "test",
    args = ["run"],
    chdir = package_name(),
    copy_data_to_bin = False,
    data = [
        ":node_modules",
        ":test_inputs",
        ":undeclared_sibling_order",
        "//tsworkspace:node_modules/vitest",
    ],
    env = {
        "VITEST_MAX_WORKERS": "4",
        "VITE_ALLOW_OUTSIDE_ROOT": "1",
        "VITE_BAZEL_RUNFILES": "1",
    },
    # Native ESM and Vite must agree on the canonical paths of declared dependencies.
    patch_node_fs = False,
    # Bazel must reserve the CPUs that Vitest's worker pool consumes.
    tags = ["cpu:4"],
)

oxlint_bin.oxlint_test(
    name = "lint",
    args = ["."],
    chdir = package_name(),
    data = [
        ":app_config",
        ":sources",
    ],
)

# Every file oxfmt formats, for the format check in //tsworkspace. A js_library
# copies them into the output tree in this package, which the js_test there
# requires of files that live outside its own package.
js_library(
    name = "fmt_inputs",
    srcs = glob(
        [
            "**/*.css",
            "**/*.html",
            "**/*.json",
            "**/*.ts",
            "**/*.tsx",
            "**/*.yaml",
        ],
        allow_empty = True,
        exclude = [
            "coverage/**",
            "dist/**",
            "src/routeTree.gen.ts",
        ],
    ),
    visibility = ["//tsworkspace:__pkg__"],
)
