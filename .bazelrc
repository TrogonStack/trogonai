common --enable_bzlmod
common --enable_platform_specific_config

# C toolchain detection must not pick up a mise shim that happens to come first
# on PATH; the system compiler is the one Xcode provides.
common:macos --repo_env=CC=/usr/bin/clang
build --color=yes
test --test_output=errors

# CI logs have no terminal to redraw the progress line in place, so every update
# became a new line and buried the errors. Keep warnings, errors, failing test
# output and the summary of tests that did not pass.
common:ci --curses=no
common:ci --noshow_loading_progress
common:ci --show_progress_rate_limit=60
common:ci --ui_event_filters=-info
build:ci --show_result=0
test:ci --test_summary=terse

try-import %workspace%/.bazelrc.local
