#!/usr/bin/env bash
#MISE dir = "{{cwd}}"
set -euo pipefail
report=.coverage-output.final
if [[ ! -f "$report" ]]; then report=.coverage-output; fi
EOF=$(dd if=/dev/urandom bs=15 count=1 status=none | base64)
{
  echo "summary<<$EOF"
  printf '%s\n' "$(cat "$report")"
  echo "$EOF"
} >> "$GITHUB_OUTPUT"
