#!/usr/bin/env bash
#MISE description="Enforce the configured minimum coverage"
#MISE dir = "{{cwd}}"
set -euo pipefail

exec python3 - <<'PY'
import os
with open('.coverage-total', 'r') as t:
  total = float(t.read().rstrip())
min = float(os.environ['COVERAGE_THRESHOLD'])
if total < min:
  raise SystemExit(
    f"Total Coverage of {total}% falls below minimum threshold of {min}%."
  )
PY
