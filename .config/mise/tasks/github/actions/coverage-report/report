#!/usr/bin/env bash
#MISE dir = "{{cwd}}"
set -euo pipefail
rm -f .coverage-comparison-status
mkdir -p coverage-action
cp "${COVERAGE_PATH}" coverage-action/
pycobertura show "${COVERAGE_PATH}" --output .coverage-output
if [[ "${COVERAGE_LOW_ONLY}" == "true" ]]
then {
  # Keep header lines, the TOTAL line, and any file with missed lines (Miss != 0)
  awk 'NR<=2 || /^TOTAL / || $3 != 0' .coverage-output > .coverage-output.filtered
  mv .coverage-output.filtered .coverage-output
}
fi
cat .coverage-output
