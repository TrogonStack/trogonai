#!/usr/bin/env bash
#MISE description="Run a cancelled CI Bazel run again once it has finished cancelling"
set -euo pipefail

# Dispatched by watch-self-hosted-queue in ci-bazel.yml, which cancels its own
# run right after, so the run is waited out here: GitHub reruns only a
# finished run.
repo="${GITHUB_REPOSITORY:?}"
run_id="${RUN_ID:?}"
[[ "$run_id" =~ ^[0-9]+$ ]] || { echo "::error::run-id must be a number, got '${run_id}'."; exit 1; }

deadline=$((SECONDS + 600))
# A failed read counts as not finished yet, so one API error does not lose the rerun.
until [[ "$(gh api "repos/${repo}/actions/runs/${run_id}" --jq .status || true)" == completed ]]; do
  ((SECONDS < deadline)) || { echo "::error::Run ${run_id} did not finish within 600s."; exit 1; }
  sleep 15
done

read -r workflow_path conclusion branch created event head_repo < <(gh api "repos/${repo}/actions/runs/${run_id}" \
  --jq '[.path, .conclusion, .head_branch, .created_at, .event, .head_repository.full_name] | @tsv')

if [[ "$workflow_path" != .github/workflows/ci-bazel.yml ]]; then
  echo "::error::Run ${run_id} is ${workflow_path}, not ci-bazel.yml."
  exit 1
fi
if [[ "$conclusion" != cancelled ]]; then
  echo "Run ${run_id} finished ${conclusion}; nothing to run again."
  exit 0
fi

# A newer run of the same branch, from the same repository and event, has
# already replaced this one, and running this one again would cancel it through
# ci-bazel.yml's concurrency group. A fork's branch of the same name is a
# different group and does not count.
newer="$(gh api "repos/${repo}/actions/workflows/ci-bazel.yml/runs?branch=${branch}&event=${event}&per_page=20" \
  --jq "[.workflow_runs[] | select(.created_at > \"${created}\" and .head_repository.full_name == \"${head_repo}\")] | length")"
if ((newer > 0)); then
  echo "Run ${run_id} has a newer run on ${branch}; leaving it cancelled."
  exit 0
fi

gh run rerun "$run_id" --repo "$repo"
echo "Run ${run_id} queued again."
