#!/usr/bin/env bash
#MISE description="Verify the downloaded archives against their sha256 files and attach them to the existing RELEASE_TAG release"
set -euo pipefail

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${DIST_DIR:?DIST_DIR is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

cd "$DIST_DIR"
sha256sum --check --strict -- *.tar.gz.sha256
# --clobber replaces the archives of an earlier run for the same tag.
gh release upload --clobber "$RELEASE_TAG" ./*.tar.gz ./*.tar.gz.sha256
