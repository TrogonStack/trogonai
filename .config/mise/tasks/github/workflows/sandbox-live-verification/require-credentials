#!/usr/bin/env bash
#MISE description="Fail when an enabled provider job has no credentials to run with"
set -euo pipefail

# An enabled provider job without credentials must fail rather than pass by
# testing nothing. Only the names of missing settings are reported.
case "${SANDBOX_SMOKE_PROVIDER:?}" in
  daytona) required=(DAYTONA_API_KEY) ;;
  vercel) required=(VERCEL_TOKEN VERCEL_TEAM_ID VERCEL_PROJECT_ID) ;;
  *)
    echo "::error::no credential check exists for provider ${SANDBOX_SMOKE_PROVIDER}"
    exit 1
    ;;
esac

missing=()
for name in "${required[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    missing+=("$name")
  fi
done

if ((${#missing[@]} > 0)); then
  echo "::error::the ${SANDBOX_SMOKE_PROVIDER} job is enabled but ${missing[*]} is not set"
  exit 1
fi
