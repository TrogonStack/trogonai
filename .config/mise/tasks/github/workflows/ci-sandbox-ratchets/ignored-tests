#!/usr/bin/env python3
#MISE description="Fail when an #[ignore] test in the sandbox crates is missing from the quarantine inventory, or listed after it is gone"
"""Quarantine inventory of #[ignore] tests in the sandbox crates.

An ignored test never runs in `cargo test`, so it can rot without anyone
noticing. The inventory lists every ignored test with its reason, and this
task fails when the tree and the inventory differ, so a new #[ignore] is added
on purpose, in review, with a reason.

    ignored-tests           fail when the tree and the inventory differ
    ignored-tests --write   regenerate the inventory

A bare #[ignore] is recorded with the reason "(none)". MAX_BARE caps how many
exist, so a new bare #[ignore] fails even when it is in the inventory; the cap
only goes down. Line numbers are left out so unrelated edits do not churn the
inventory.
"""
import argparse
import collections
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
SCAN = ROOT / "rsworkspace" / "crates" / "sandbox"
INVENTORY = SCAN / "ignored-tests.tsv"
TASK = "mise run github:workflows:ci-sandbox-ratchets:ignored-tests"
NO_REASON = "(none)"
# Bare #[ignore] attributes that predate the inventory. Only ever lower this.
MAX_BARE = 1

IGNORE = re.compile(r'^\s*#\[ignore(?:\s*=\s*"((?:[^"\\]|\\.)*)")?\s*\]')
FN = re.compile(r"\bfn\s+([A-Za-z_][A-Za-z0-9_]*)")
HEADER = [
    "# Quarantine inventory of #[ignore] tests in the sandbox crates.",
    f"# Generated by `{TASK} -- --write`; do not edit by hand.",
    "# Format: path<TAB>test fn<TAB>reason.",
]


def scan():
    listed = subprocess.check_output(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", ":(glob)rsworkspace/crates/sandbox/**/*.rs"],
        cwd=ROOT,
        text=True,
    )
    entries = []
    for name in sorted(n for n in listed.split("\0") if n):
        path = ROOT / name
        if not path.is_file():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        for i, line in enumerate(lines):
            m = IGNORE.match(line)
            if not m:
                continue
            reason = (m.group(1) or NO_REASON).replace("\t", " ")
            test = next((f.group(1) for f in map(FN.search, lines[i + 1 : i + 12]) if f), "?")
            entries.append(f"{name}\t{test}\t{reason}")
    return sorted(entries)


def read_inventory():
    if not INVENTORY.exists():
        return []
    return [l for l in INVENTORY.read_text(encoding="utf-8").splitlines() if l and not l.startswith("#")]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--write", action="store_true", help="regenerate the inventory")
    args = ap.parse_args()

    current = scan()
    if args.write:
        INVENTORY.write_text("\n".join(HEADER + current) + "\n", encoding="utf-8")
        print(f"wrote {len(current)} entries to {INVENTORY.relative_to(ROOT)}")
        return 0

    bare = sum(1 for e in current if e.endswith("\t" + NO_REASON))
    if bare > MAX_BARE:
        print(f'::error::{bare} bare #[ignore] attributes, the cap is {MAX_BARE}; give the new test a reason: #[ignore = "why"]')
        return 1
    have = collections.Counter(read_inventory())
    now = collections.Counter(current)
    added = sorted((now - have).elements())
    removed = sorted((have - now).elements())
    for e in added:
        path, test, reason = e.split("\t")
        print(f"::error file={path}::new #[ignore] on {test} is not in the quarantine inventory")
        if reason == NO_REASON:
            print(f'::error file={path}::#[ignore] on {test} has no reason; use #[ignore = "why"]')
    for e in removed:
        path, test, _ = e.split("\t")
        print(f"::error::the inventory lists an #[ignore] on {test} in {path} that no longer exists")
    if added or removed:
        print(
            f"Run `{TASK} -- --write` and commit {INVENTORY.relative_to(ROOT)}. "
            "An ignored test needs a reason and a job or script that runs it."
        )
        return 1
    print(f"ignored-test inventory is current ({len(current)} entries)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
