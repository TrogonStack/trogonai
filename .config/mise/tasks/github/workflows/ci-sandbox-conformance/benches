#!/usr/bin/env bash
#MISE description="Build the sandbox benches without running them"
set -euo pipefail

ROOT="${GITHUB_WORKSPACE:-$(git rev-parse --show-toplevel)}"
cd "$ROOT/rsworkspace"

# The sandbox crates that have a `benches` directory. Building is the check: a bench
# that no longer compiles is otherwise found only when someone next measures.
cargo bench --locked --no-run \
    --package trogon-sandbox-broker --bench admission \
    --package trogon-sandbox-conformance --bench memory_worker
