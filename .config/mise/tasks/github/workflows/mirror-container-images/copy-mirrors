#!/usr/bin/env bash
#MISE description="Copy the pinned third-party images, with their signatures and attestations, to ghcr.io/trogonstack/mirrors"
set -euo pipefail
# Reads devops/oras/mirrors.txt and runs `oras copy -r` for each line, so the
# referrers of an image follow it. The copy keeps the upstream digest, which is
# checked afterwards. Copying the same digest again leaves the mirror as it is.
#
# Needs oras on PATH and a login to ghcr.io (MIRROR_REGISTRY_USERNAME and
# MIRROR_REGISTRY_PASSWORD, or an existing oras or docker login).

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
mirrors="${MIRRORS_FILE:-devops/oras/mirrors.txt}"
destination="${MIRROR_REGISTRY:-ghcr.io/trogonstack/mirrors}"

if [ -n "${MIRROR_REGISTRY_PASSWORD:-}" ]; then
    printf '%s' "$MIRROR_REGISTRY_PASSWORD" |
        oras login "${destination%%/*}" --username "${MIRROR_REGISTRY_USERNAME:?MIRROR_REGISTRY_USERNAME is required}" --password-stdin
fi

count=0
while read -r upstream reference; do
    case "$upstream" in
    '' | '#'*) continue ;;
    esac
    if [[ ! "$reference" =~ ^([a-z0-9._/-]+):([A-Za-z0-9._-]+)@(sha256:[0-9a-f]{64})$ ]]; then
        echo "not a pinned <path>:<tag>@sha256:<digest> reference: ${reference}" >&2
        exit 1
    fi
    path="${BASH_REMATCH[1]}"
    tag="${BASH_REMATCH[2]}"
    digest="${BASH_REMATCH[3]}"
    if [ "$tag" = "latest" ]; then
        echo "${reference} pins latest; pin an exact version" >&2
        exit 1
    fi
    case "$upstream" in
    docker-hub) host=docker.io ;;
    quay) host=quay.io ;;
    ghcr) host=ghcr.io ;;
    *)
        echo "unknown upstream ${upstream}" >&2
        exit 1
        ;;
    esac
    target="${destination}/${upstream}/${path}:${tag}"
    echo "== ${host}/${path}@${digest} -> ${target}"
    oras copy -r "${host}/${path}@${digest}" "${target}"
    copied="$(oras resolve "$target")"
    if [ "$copied" != "$digest" ]; then
        echo "${target} is ${copied}, expected ${digest}" >&2
        exit 1
    fi
    count=$((count + 1))
done <"$mirrors"
echo "mirrored ${count} images"
