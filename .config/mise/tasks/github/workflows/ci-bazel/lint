#!/usr/bin/env bash
#MISE description="Run the Bazel lint aspects over every target using the GitHub Actions caches"
set -euo pipefail

# --keep_going so one target's findings do not hide the findings of all others.
exec bazel build \
  --config=ci \
  --config=lint \
  --keep_going \
  --disk_cache="${RUNNER_TEMP:?}/bazel-disk-cache" \
  --repository_cache="${RUNNER_TEMP:?}/bazel-repository-cache" \
  //...
