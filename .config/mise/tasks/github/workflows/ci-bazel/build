#!/usr/bin/env bash
#MISE description="Build every Bazel target using the GitHub Actions caches"
set -euo pipefail

# The coverage config matches the test run, so the targets it already built
# come from the cache instead of building again without instrumentation.
# --keep_going so one broken target does not hide the results of all others.
exec bazel build \
  --config=ci \
  --config=coverage \
  --keep_going \
  --disk_cache="${RUNNER_TEMP:?}/bazel-disk-cache" \
  --repository_cache="${RUNNER_TEMP:?}/bazel-repository-cache" \
  //...
