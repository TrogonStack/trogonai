#!/usr/bin/env bash
#MISE description="Build every Bazel target using the runner's Bazel cache"
set -euo pipefail

mkdir -p "${RUNNER_TEMP:?}/bazel-profiles"

# The coverage config matches the test run, so the targets it already built
# come from the cache instead of building again without instrumentation.
# --keep_going so one broken target does not hide the results of all others.
exec bazel build \
  --config=ci \
  --config=coverage \
  --keep_going \
  --profile="$RUNNER_TEMP/bazel-profiles/build.profile.gz" \
  //...
