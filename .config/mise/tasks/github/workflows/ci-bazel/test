#!/usr/bin/env bash
#MISE description="Run every Bazel test with coverage using the GitHub Actions caches"
set -euo pipefail

# Coverage runs every test as `bazel test` would, so the tests run once and
# also produce the report the coverage gate reads.
# --keep_going so one broken target does not hide the results of all others.
exec bazel coverage \
  --config=ci \
  --config=coverage \
  --keep_going \
  --disk_cache="${RUNNER_TEMP:?}/bazel-disk-cache" \
  --repository_cache="${RUNNER_TEMP:?}/bazel-repository-cache" \
  //...
