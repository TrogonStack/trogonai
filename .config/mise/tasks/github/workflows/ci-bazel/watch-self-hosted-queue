#!/usr/bin/env bash
#MISE description="Requeue the run when verify waits too long for a self-hosted runner"
set -euo pipefail

# choose-runner sends verify to a self-hosted runner it saw idle, but nothing
# reserves that runner: another run can take it first, and if every
# self-hosted runner then goes offline, GitHub keeps verify queued for up to
# 24 hours. Past the limit this asks ci-requeue.yml to run the whole run again,
# so choose-runner looks at the runners afresh, and cancels this attempt.
repo="${GITHUB_REPOSITORY:?}"
run_id="${GITHUB_RUN_ID:?}"
attempt="${GITHUB_RUN_ATTEMPT:?}"
job="${WATCHED_JOB:?}"
limit="${QUEUE_LIMIT_SECONDS:?}"
max_attempts="${MAX_RUN_ATTEMPTS:?}"
deadline=$((SECONDS + limit))

# Acts only on a status it read: a failed read keeps watching rather than end
# the watch or cancel a verify that may have started, and the deadline is
# checked after a read so the last status seen is current.
while true; do
  if status="$(gh api "repos/${repo}/actions/runs/${run_id}/attempts/${attempt}/jobs" \
    --jq ".jobs[] | select(.name == \"${job}\") | .status")"; then
    case "$status" in
      queued | waiting | pending | requested)
        ((SECONDS < deadline)) || break
        ;;
      *)
        echo "${job} is ${status:-not in this attempt}; nothing to watch."
        exit 0
        ;;
    esac
  else
    echo "::warning::Could not read ${job}'s status; trying again."
  fi
  sleep 20
done

if ((attempt >= max_attempts)); then
  echo "::error::${job} waited ${limit}s for a self-hosted runner on attempt ${attempt} of ${max_attempts}; cancelling without another attempt. Check that the self-hosted runners are online."
else
  echo "::warning::${job} waited ${limit}s for a self-hosted runner; running the workflow again to choose runners afresh."
  gh workflow run ci-requeue.yml --repo "$repo" --ref "${DEFAULT_BRANCH:?}" -f run-id="$run_id"
fi
gh run cancel "$run_id" --repo "$repo"
