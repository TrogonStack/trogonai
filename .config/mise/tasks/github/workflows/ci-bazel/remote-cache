#!/usr/bin/env bash
#MISE description="Point Bazel at the self-hosted runner's remote cache when the runner has one"
set -euo pipefail

# Self-hosted runners carry SUNNY_GO_BAZEL_CACHE in the runner process
# environment, which step shells see but `if:` expressions do not, so the
# detection happens here and is reported as the `enabled` step output. Hosted
# runners have no such variable and nothing is written, so their jobs keep
# using the GitHub Actions caches.
#
# The cache allows anonymous reads and requires HTTP basic auth for writes.
# SUNNY_GO_CACHE_PASSWORD is set by the workflow on pushes to main only, so
# every other run is read-only and never holds the credential. Runner homes
# persist across jobs, so the file lives under RUNNER_TEMP and the workflow
# deletes it when the job ends.
endpoint="${SUNNY_GO_BAZEL_CACHE:-}"
rc="${RUNNER_TEMP:?}/bazel-remote.bazelrc"
output="${GITHUB_OUTPUT:-/dev/null}"

rm -f "$rc"

if [[ -z $endpoint ]]; then
  echo "enabled=false" >>"$output"
  echo "No remote Bazel cache on this runner."
  exit 0
fi

if [[ ! $endpoint =~ ^grpcs?://[A-Za-z0-9.:-]+$ ]]; then
  echo "::warning::SUNNY_GO_BAZEL_CACHE is not a grpc:// or grpcs:// endpoint, so Bazel runs without a remote cache."
  echo "enabled=false" >>"$output"
  exit 0
fi

umask 077
{
  echo "# Remote cache for this job; generated by ci-bazel:remote-cache."
  echo "build --remote_cache=$endpoint"
  # Outputs are fetched only when a local action or a top level target needs
  # them. toplevel, not minimal, because the coverage report and the lint
  # output groups are top level outputs that later steps read from disk.
  echo "build --remote_download_outputs=toplevel"
  # The cache is on the same private network, and the default of 60s per call
  # would stall every action when the server is down.
  echo "build --remote_timeout=10s"
  echo "build --remote_retries=2"
  echo "build --remote_retry_max_delay=2s"
  # Stop calling the cache once more than 10% of calls failed within a minute,
  # so a dead server costs one window of failures and the build then runs cold.
  echo "build --experimental_circuit_breaker_strategy=failure"
  echo "build --experimental_remote_failure_rate_threshold=10"
  echo "build --experimental_remote_failure_window_interval=60s"
  # Without these two, an unreachable cache fails the first action with
  # "Failed to query remote execution capabilities". Verified on Bazel 9.3.2:
  # with them the build runs locally, as if the cache were absent.
  echo "build --remote_local_fallback"
  echo "build --incompatible_remote_local_fallback_for_remote_cache"
  # Rebuild when a blob the cache listed has since been evicted.
  echo "build --experimental_remote_cache_eviction_retries=5"
} >"$rc"

if [[ -n ${SUNNY_GO_CACHE_PASSWORD:-} ]]; then
  header=$(printf 'ci:%s' "$SUNNY_GO_CACHE_PASSWORD" | base64 | tr -d '\n')
  echo "::add-mask::$header"
  echo "build --remote_cache_header=\"Authorization=Basic $header\"" >>"$rc"
  echo "build --remote_upload_local_results=true" >>"$rc"
  echo "Remote Bazel cache $endpoint, read and write."
else
  echo "build --remote_upload_local_results=false" >>"$rc"
  echo "Remote Bazel cache $endpoint, read only."
fi

echo "enabled=true" >>"$output"
