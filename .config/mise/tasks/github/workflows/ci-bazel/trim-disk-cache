#!/usr/bin/env bash
#MISE description="Wait for Bazel to trim the disk cache before GitHub Actions saves it"
set -euo pipefail

# Bazel collects the disk cache garbage in the background once its server is
# idle (see the ci config in .bazelrc), and nothing reports when it is done, so
# this waits for the cache to fit the limit. A slow collection only means a
# larger cache entry, which is no reason to fail the run.
cache="${RUNNER_TEMP:?}/bazel-disk-cache"
limit=$((4 * 1024 * 1024 * 1024))
deadline=$((SECONDS + 300))

[[ -d "$cache" ]] || exit 0

# Bazel deletes entries while this measures the cache, so du failed on files
# it had listed but could no longer stat. find skips those races and still
# fails on any other error.
cache_size() {
  find "$cache" -ignore_readdir_race -type f -printf '%s\n' | awk '{ total += $1 } END { print total + 0 }'
}

while :; do
  size=$(cache_size)
  if ((size <= limit)); then
    echo "Bazel disk cache is ${size} bytes."
    exit 0
  fi
  if ((SECONDS >= deadline)); then
    echo "::warning::Bazel disk cache is still ${size} bytes, over the ${limit} byte limit."
    exit 0
  fi
  sleep 10
done
