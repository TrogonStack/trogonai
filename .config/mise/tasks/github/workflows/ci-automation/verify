#!/usr/bin/env bash
#MISE description="Validate CI selection, workflow syntax, and canary helpers without building workspaces"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
npm ci --prefix tests/github_actions --ignore-scripts --no-audit --no-fund
node --test tests/github_actions/test_ci_selection.mjs tests/github_actions/test_ci_selector_process.mjs tests/github_actions/test_runs_on_fallback.mjs
python3 -m unittest discover -s tests/github_actions -p 'test_*.py'
bash -n .config/mise/tasks/github/workflows/canary-container-images/canary-is-branch-tip
actionlint -shellcheck=''
