#!/usr/bin/env bash
#MISE description="Write the published or freshly built image digest to GITHUB_OUTPUT and to a file the chart job reads"
set -euo pipefail

: "${DIGEST:?DIGEST is required}"
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"
: "${SERVICE:?SERVICE is required}"
: "${DIGEST_DIR:?DIGEST_DIR is required}"

if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "::error title=Invalid image digest::${SERVICE}: ${DIGEST}"
    exit 1
fi

echo "digest=${DIGEST}" >>"$GITHUB_OUTPUT"
mkdir -p "$DIGEST_DIR"
printf '%s\n' "$DIGEST" >"${DIGEST_DIR}/${SERVICE}"
