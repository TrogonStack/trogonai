#!/usr/bin/env bash
#MISE description="Start the local sandbox stack and a docker worker, then check both stay connected to NATS"
# Starts the local stack (NATS and the broker in compose) and a docker worker on
# the host, then checks that both stay up and hold their NATS connections past
# one worker heartbeat. Needs docker with compose, curl, jq, openssl and cargo.
#
# Optional: SANDBOX_NATS_PORT and SANDBOX_NATS_MONITOR_PORT (defaults 24222 and
# 28222), SANDBOX_IMAGE (the lease image, default sandbox-agent:dev, built from
# devops/docker/images/sandbox-agent), SANDBOX_EGRESS_PROXY_IMAGE.
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
STACK="${ROOT}/devops/docker/compose/sandbox"
COMPOSE=(docker compose -f "${STACK}/compose.yaml")
export SANDBOX_NATS_PORT="${SANDBOX_NATS_PORT:-24222}"
export SANDBOX_NATS_MONITOR_PORT="${SANDBOX_NATS_MONITOR_PORT:-28222}"
NATS="nats://127.0.0.1:${SANDBOX_NATS_PORT}"

# Signed dispatches, required by the worker: the posture of a shipped deployment.
# shellcheck source=../../lib/sandbox-dispatch-keys.sh
source "${ROOT}/.config/mise/lib/sandbox-dispatch-keys.sh"

cleanup() {
  if [[ -n "${WORKER_PID:-}" ]]; then
    kill "${WORKER_PID}" 2>/dev/null || true
    wait "${WORKER_PID}" 2>/dev/null || true
  fi
  rm -rf "${WORKER_STATE:-}"
}
trap cleanup EXIT

echo "Starting NATS and the broker (${NATS})..."
"${COMPOSE[@]}" down --remove-orphans 2>/dev/null || true
"${COMPOSE[@]}" up -d --build

echo "Waiting for NATS..."
for _ in $(seq 30); do
  curl -fsS "http://127.0.0.1:${SANDBOX_NATS_MONITOR_PORT}/healthz" >/dev/null 2>&1 && break
  sleep 1
done

echo "Building trogon-sandbox-docker-worker..."
cd "${ROOT}/rsworkspace"
cargo build -q --release -p trogon-sandbox-docker-worker
TARGET="$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)"
BIN="${TARGET}/release/trogon-sandbox-docker-worker"

echo "Starting ${BIN}..."
WORKER_STATE="$(mktemp -d)"
env SANDBOX_DOCKER_STATE_DIR="${WORKER_STATE}" \
  SANDBOX_NATS_URL="${NATS}" \
  SANDBOX_IMAGE="${SANDBOX_IMAGE:-sandbox-agent:dev}" \
  ${SANDBOX_EGRESS_PROXY_IMAGE:+"SANDBOX_EGRESS_PROXY_IMAGE=${SANDBOX_EGRESS_PROXY_IMAGE}"} \
  "${BIN}" &
WORKER_PID=$!

# The broker routes only to workers it has heard a heartbeat from; wait out one
# heartbeat interval before checking.
sleep 12
if ! kill -0 "${WORKER_PID}" 2>/dev/null; then
  echo "the worker exited during startup" >&2
  exit 1
fi
if [[ -z "$("${COMPOSE[@]}" ps --status running -q trogon-sandbox-broker)" ]]; then
  echo "the broker exited during startup:" >&2
  "${COMPOSE[@]}" logs --tail 20 trogon-sandbox-broker >&2
  exit 1
fi
connections="$(curl -fsS "http://127.0.0.1:${SANDBOX_NATS_MONITOR_PORT}/connz" | jq .num_connections)"
if [[ "${connections}" -lt 2 ]]; then
  echo "expected the broker and the worker on NATS, found ${connections} connection(s)" >&2
  exit 1
fi
echo "OK. To stop the stack: docker compose -f ${STACK}/compose.yaml down"
