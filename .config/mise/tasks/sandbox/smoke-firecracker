#!/usr/bin/env bash
#MISE description="Run the firecracker integration lanes against the local sandbox stack on a KVM host"
# Full path on a KVM host: NATS and the broker in compose, then
# trogon-sandbox-firecracker-worker on the host booting microVMs, then the
# firecracker lanes of trogon-sandbox-client against them. Needs docker with
# compose, curl, jq, openssl, cargo and a Firecracker binary.
#
# Required: FC_KERNEL (the guest vmlinux) and FC_ROOTFS (a rootfs built by
# rsworkspace/crates/sandbox/trogon-sandbox-firecracker-worker/scripts/build-guest-rootfs.sh).
# Optional: FC_BINARY (default `firecracker` on PATH), FC_STATE_DIR (default
# $HOME/.sandbox-fc-smoke), FC_SNAPSHOT_DIR (default ${FC_STATE_DIR}-snapshots,
# emptied before and after the run), FC_IMAGE (default guest:base),
# CARGO_BUILD_JOBS.
#
# Concurrent runs on one host need their own SANDBOX_NATS_PORT,
# SANDBOX_NATS_MONITOR_PORT, COMPOSE_PROJECT_NAME and FC_STATE_DIR.
#
# SANDBOX_SMOKE_FIRECRACKER_NETWORK=1 starts the worker with lease network
# devices and also runs firecracker_network_smoke. It needs the netns helper
# (trogon-sandbox-firecracker-worker/scripts/fc-netns) installed as root with a
# sudo rule: FC_NETNS_HELPER (default /usr/local/sbin/fc-netns) and
# FC_NETNS_PREFIX (default sbxfc-, which must match the helper's own prefix).
#
# SANDBOX_SMOKE_FIRECRACKER_TESTS replaces the trogon-sandbox-client test
# targets to run (space separated), including the failure, snapshot and timing
# lanes that otherwise run after them.
#
# firecracker_credential_smoke runs only when named there, with
# SANDBOX_SMOKE_FIRECRACKER_NETWORK=1 and a trogon-sandbox-credential-broker on
# the same NATS: export SANDBOX_FIRECRACKER_CREDENTIAL_BROKER_NATS_URL for the
# worker and the variables that lane documents.
#
# The worker runs under a supervisor that restarts it when it dies, so the
# failure lane can kill it with leases live and watch the restarted worker
# reclaim them.
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
STACK="${ROOT}/devops/docker/compose/sandbox"
COMPOSE=(docker compose -f "${STACK}/compose.yaml")
export SANDBOX_NATS_PORT="${SANDBOX_NATS_PORT:-24222}"
export SANDBOX_NATS_MONITOR_PORT="${SANDBOX_NATS_MONITOR_PORT:-28222}"
export SANDBOX_NATS_URL="nats://127.0.0.1:${SANDBOX_NATS_PORT}"

# Signed dispatches, required by the worker: the posture of a shipped deployment.
# shellcheck source=../../lib/sandbox-dispatch-keys.sh
source "${ROOT}/.config/mise/lib/sandbox-dispatch-keys.sh"
: "${FC_KERNEL:?set FC_KERNEL to the guest vmlinux}"
: "${FC_ROOTFS:?set FC_ROOTFS to the guest rootfs.ext4}"
export SANDBOX_FIRECRACKER_IMAGE="${FC_IMAGE:-guest:base}"
export SANDBOX_FIRECRACKER_STATE_DIR="${FC_STATE_DIR:-${HOME}/.sandbox-fc-smoke}"
FC_SNAPSHOT_DIR="${FC_SNAPSHOT_DIR:-${SANDBOX_FIRECRACKER_STATE_DIR}-snapshots}"
rm -rf "${FC_SNAPSHOT_DIR}"
NETWORK="${SANDBOX_SMOKE_FIRECRACKER_NETWORK:-0}"
JOBS=(${CARGO_BUILD_JOBS:+-j "${CARGO_BUILD_JOBS}"})
LOGS="$(mktemp -d)"
WORKER_PIDFILE="${LOGS}/worker.pid"
WORKER_STOP="${LOGS}/worker.stop"
export SANDBOX_SMOKE_FIRECRACKER_WORKER_PIDFILE="${WORKER_PIDFILE}"

cleanup() {
  if [[ -n "${SUPERVISOR_PID:-}" ]]; then
    touch "${WORKER_STOP}"
    kill -INT "$(cat "${WORKER_PIDFILE}" 2>/dev/null)" 2>/dev/null || true
    wait "${SUPERVISOR_PID}" 2>/dev/null || true
  fi
  "${COMPOSE[@]}" logs trogon-sandbox-broker >"${LOGS}/broker.log" 2>&1 || true
  "${COMPOSE[@]}" down --remove-orphans >/dev/null 2>&1 || true
  rm -rf "${FC_SNAPSHOT_DIR}"
  echo "Logs: ${LOGS}"
}
trap cleanup EXIT

echo "Starting NATS and the broker (${SANDBOX_NATS_URL})..."
"${COMPOSE[@]}" down --remove-orphans 2>/dev/null || true
"${COMPOSE[@]}" up -d --build

echo "Waiting for NATS..."
for _ in $(seq 30); do
  curl -fsS "http://127.0.0.1:${SANDBOX_NATS_MONITOR_PORT}/healthz" >/dev/null 2>&1 && break
  sleep 1
done

PACKAGES=(-p trogon-sandbox-firecracker-worker)
TESTS=(--test firecracker_stack_smoke)
if [[ "${NETWORK}" == 1 ]]; then
  PACKAGES+=(-p trogon-sandbox-egress-proxy)
  TESTS+=(--test firecracker_network_smoke)
fi
SERIAL_TESTS=(
  --test firecracker_stack_failures
  --test firecracker_stack_snapshots
  --test firecracker_stack_timings
)
if [[ -n "${SANDBOX_SMOKE_FIRECRACKER_TESTS:-}" ]]; then
  TESTS=()
  SERIAL_TESTS=()
  for test in ${SANDBOX_SMOKE_FIRECRACKER_TESTS}; do
    TESTS+=(--test "${test}")
  done
fi

echo "Building ${PACKAGES[*]}..."
cd "${ROOT}/rsworkspace"
cargo build -q ${JOBS[@]+"${JOBS[@]}"} "${PACKAGES[@]}"
TARGET="$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)"

WORKER_ARGS=()
if [[ "${NETWORK}" == 1 ]]; then
  export SANDBOX_FIRECRACKER_NETNS_PREFIX="${FC_NETNS_PREFIX:-sbxfc-}"
  WORKER_ARGS=(
    --netns-helper "${FC_NETNS_HELPER:-/usr/local/sbin/fc-netns}"
    --netns-prefix "${SANDBOX_FIRECRACKER_NETNS_PREFIX}"
    --egress-proxy-binary "${TARGET}/debug/trogon-sandbox-egress-proxyd"
  )
fi

(
  while [[ ! -e "${WORKER_STOP}" ]]; do
    SANDBOX_INSECURE_DEV=true \
    SANDBOX_FIRECRACKER_BINARY="${FC_BINARY:-firecracker}" \
    SANDBOX_FIRECRACKER_KERNEL="${FC_KERNEL}" \
    SANDBOX_FIRECRACKER_ROOTFS="${FC_ROOTFS}" \
    SANDBOX_FIRECRACKER_SNAPSHOT_DIR="${FC_SNAPSHOT_DIR}" \
      "${TARGET}/debug/trogon-sandbox-firecracker-worker" ${WORKER_ARGS[@]+"${WORKER_ARGS[@]}"} \
      >>"${LOGS}/worker.log" 2>&1 &
    echo $! >"${WORKER_PIDFILE}"
    wait $! || echo "worker exited with $?, restarting" >>"${LOGS}/worker.log"
  done
) &
SUPERVISOR_PID=$!

# The broker routes only to workers it has heard a heartbeat from, and the
# worker's first one can go out before the broker subscribes, so wait out one
# heartbeat interval.
sleep 12
if ! kill -0 "$(cat "${WORKER_PIDFILE}")" 2>/dev/null; then
  echo "the worker exited during startup:" >&2
  tail -20 "${LOGS}/worker.log" >&2
  exit 1
fi
if [[ -z "$("${COMPOSE[@]}" ps --status running -q trogon-sandbox-broker)" ]]; then
  echo "the broker exited during startup:" >&2
  "${COMPOSE[@]}" logs --tail 20 trogon-sandbox-broker >&2
  exit 1
fi

echo "Running ignored integration tests..."
# Two at a time keeps the peak (the concurrency test plus one more) under the
# worker's default of 8 concurrent leases.
if [[ ${#TESTS[@]} -gt 0 ]]; then
  cargo test -q ${JOBS[@]+"${JOBS[@]}"} -p trogon-sandbox-client "${TESTS[@]}" -- --ignored --nocapture --test-threads=2 "$@"
fi
if [[ ${#SERIAL_TESTS[@]} -gt 0 ]]; then
  # One at a time: the failure lane kills the VMM or the worker itself, which
  # would take other tests' leases down with them, and the timings must measure
  # the stack alone.
  cargo test -q ${JOBS[@]+"${JOBS[@]}"} -p trogon-sandbox-client "${SERIAL_TESTS[@]}" -- --ignored --nocapture --test-threads=1 "$@"
fi

leftover_vms="$(pgrep -f -- "${SANDBOX_FIRECRACKER_STATE_DIR}/" || true)"
if [[ -n "${leftover_vms}" ]]; then
  echo "firecracker processes outlived their leases: ${leftover_vms}" >&2
  exit 1
fi
# The dispatch ledger (dispatch.json and its lock and sidecar files) outlives
# every lease by design, so only lease directories count.
leftover_dirs=()
shopt -s nullglob dotglob
for entry in "${SANDBOX_FIRECRACKER_STATE_DIR}"/*; do
  [[ "${entry##*/}" == dispatch.* ]] || leftover_dirs+=("${entry##*/}")
done
shopt -u nullglob dotglob
if [[ ${#leftover_dirs[@]} -gt 0 ]]; then
  echo "lease directories outlived their leases:" >&2
  printf '%s\n' "${leftover_dirs[@]}" >&2
  exit 1
fi
if [[ "${NETWORK}" == 1 ]]; then
  leftover_netns="$(ip netns list | grep -- "^${SANDBOX_FIRECRACKER_NETNS_PREFIX}" || true)"
  if [[ -n "${leftover_netns}" ]]; then
    echo "network namespaces outlived their leases:" >&2
    echo "${leftover_netns}" >&2
    exit 1
  fi
fi
echo "No VMs, lease directories or network namespaces left behind."
