#!/usr/bin/env bash
#MISE description="Report whether an image tag already exists, so a rerun never moves an immutable tag"
set -euo pipefail

: "${IMAGE_REF:?IMAGE_REF is required}"
: "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"

if output="$(docker buildx imagetools inspect --format '{{json .Manifest.Digest}}' "$IMAGE_REF" 2>&1)"; then
    echo "published=true" >>"$GITHUB_OUTPUT"
    echo "::notice title=Image already published::${IMAGE_REF} is ${output}; skipping the build"
elif [[ "$output" == *": not found"* ]]; then
    echo "published=false" >>"$GITHUB_OUTPUT"
else
    echo "$output" >&2
    exit 1
fi
