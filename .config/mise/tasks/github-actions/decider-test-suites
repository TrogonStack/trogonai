#!/usr/bin/env python3
#MISE description="Run wasm decider conformance: sim schedules suite, macro compile-fail tests, every decider-test YAML fixture, and every native/wasm parity test"
#
# The gate is on coverage, not just on results. Every wasm-components/* decider
# must satisfy two independent requirements, and must either satisfy each one or
# declare in its own Cargo.toml why it does not:
#
#     [package.metadata.decider-test]
#     exempt = "why this component has no cli/trogon-decider-test/{alias}.yaml suite"
#
#     [package.metadata.decider-parity]
#     exempt = "why this component has no trogon-decider-sim parity_{alias} test"
#
# The two answer different questions. A conformance suite asks whether the
# component still does what it is specified to do. A parity test asks whether
# the native decider and the compiled component do the *same* thing, which is
# the guarantee that makes the native path a usable stand-in for the wasm one.
# A component can honestly have one and not the other: parity needs the decider
# logic to live in a shared crate both sides can call, and a component whose
# logic lives only in its own cdylib has no native side to compare against.
#
# A component that has neither the artifact nor the exemption fails this task.
# The declaration lives in the component's manifest rather than in a list here
# so that deleting a component deletes its exemption, and so that adding one
# makes the question unavoidable instead of answering it by silence.
import os
import subprocess
import sys
import tomllib
from pathlib import Path

root = Path(
    os.environ.get("GITHUB_WORKSPACE")
    or subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
)
workspace = root / "rsworkspace"
suites_dir = workspace / "cli" / "trogon-decider-test"
components_dir = workspace / "wasm-components"
artifacts_dir = workspace / "dist" / "decider"
parity_dir = workspace / "crates" / "decider" / "trogon-decider-sim" / "tests"


def run(*command):
    completed = subprocess.run(command, cwd=workspace, check=False)
    if completed.returncode != 0:
        sys.exit(f"{' '.join(command)} exited {completed.returncode}")


def alias_of(crate):
    return crate.removeprefix("trogon-").removesuffix("-decider")


def exemption(manifest_path, table):
    with open(manifest_path, "rb") as manifest_file:
        manifest = tomllib.load(manifest_file)
    metadata = manifest.get("package", {}).get("metadata", {}).get(table, {})
    return metadata.get("exempt")


manifests = sorted(components_dir.glob("*/Cargo.toml"))
if not manifests:
    sys.exit(f"no decider components found under {components_dir}")

# Coverage is resolved before anything is run, so a component that nobody wrote
# a suite for is reported in seconds rather than after a full test build.
violations = []
runnable = []
parity_targets = []
claimed_suites = set()
claimed_parity = set()

for manifest in manifests:
    alias = alias_of(manifest.parent.name)

    suite = suites_dir / f"{alias}.yaml"
    suite_exempt = exemption(manifest, "decider-test")
    if suite.exists():
        claimed_suites.add(suite.name)

    if suite_exempt and suite.exists():
        violations.append(
            f"{manifest}: declares a decider-test exemption but {suite.name} exists; "
            "drop the exemption so the suite is enforced"
        )
    elif suite_exempt:
        print(f"conformance-exempt {alias}: {suite_exempt}")
    elif not suite.exists():
        violations.append(
            f"{manifest.parent.name}: no conformance suite at {suite} and no "
            '[package.metadata.decider-test] exempt = "..." explaining why'
        )
    else:
        component = artifacts_dir / f"{alias}.wasm"
        if component.exists():
            runnable.append((component, suite))
        else:
            violations.append(f"{component} was not built; run 'mise run artifacts:wasm-components' first")

    parity = parity_dir / f"parity_{alias}.rs"
    parity_exempt = exemption(manifest, "decider-parity")
    if parity.exists():
        claimed_parity.add(parity.name)

    if parity_exempt and parity.exists():
        violations.append(
            f"{manifest}: declares a decider-parity exemption but {parity.name} exists; "
            "drop the exemption so the parity test is enforced"
        )
    elif parity_exempt:
        print(f"parity-exempt {alias}: {parity_exempt}")
    elif not parity.exists():
        violations.append(
            f"{manifest.parent.name}: no parity test at {parity} and no "
            '[package.metadata.decider-parity] exempt = "..." explaining why'
        )
    else:
        parity_targets.append(f"parity_{alias}")

for suite in sorted(suites_dir.glob("*.yaml")):
    if suite.name not in claimed_suites:
        violations.append(f"{suite} is not the suite of any wasm-components/* decider")

for parity in sorted(parity_dir.glob("parity_*.rs")):
    if parity.name not in claimed_parity:
        violations.append(f"{parity} is not the parity test of any wasm-components/* decider")

if violations:
    print("decider conformance gate failed:", file=sys.stderr)
    print("\n".join(f"  {violation}" for violation in violations), file=sys.stderr)
    sys.exit(1)

run("cargo", "test", "-p", "trogon-decider-sim", "--test", "schedules", "--features", "test-support")
for target in parity_targets:
    run("cargo", "test", "-p", "trogon-decider-sim", "--test", target, "--features", "test-support")
run("cargo", "test", "-p", "trogon-decider-guest-macros", "--test", "compile_fail")
run("cargo", "build", "-p", "trogon-decider-test", "--release")

for component, suite in runnable:
    run(str(workspace / "target" / "release" / "decider-test"), str(component), str(suite))
