#!/usr/bin/env python3
#MISE description="Select coverage regression gates from the trusted workflow event"

import argparse
import json
import os
from pathlib import Path


def main():
    argparse.ArgumentParser().parse_args()
    reset = False
    if os.environ["GITHUB_EVENT_NAME"] == "pull_request":
        event = json.loads(Path(os.environ["GITHUB_EVENT_PATH"]).read_text())
        reset = any(
            label["name"] == "rust:coverage-baseline-reset"
            for label in event["pull_request"].get("labels", [])
        )
    with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
        output.write(f"enforce_regressions={str(not reset).lower()}\n")


if __name__ == "__main__":
    main()
