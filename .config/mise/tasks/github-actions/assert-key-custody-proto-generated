#!/usr/bin/env bash
#MISE description="Assert regenerated TypeScript key custody bindings match what's committed"
set -euo pipefail

ROOT="${GITHUB_WORKSPACE:-$(git rev-parse --show-toplevel)}"
cd "$ROOT"

targets=(
  tsworkspace/packages/proto/src/gen/trogonai/platform/key_custody
  tsworkspace/packages/proto/src/gen/buf/validate/validate_pb.ts
  tsworkspace/packages/proto/src/gen/trogon/hierarchy/v1alpha1/node_pb.ts
)
drift=$(git status --short --untracked-files=all -- "${targets[@]}")
if [[ -n "$drift" ]]; then
  printf '%s\n' "$drift"
  exit 1
fi
