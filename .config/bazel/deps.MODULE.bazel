bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_mise", version = "1.0.0")
bazel_dep(name = "toml.bzl", version = "0.3.0")

# Downloadable tools come from the mise lockfile, verified by its checksums.
mise = use_extension("@rules_mise//mise:extensions.bzl", "mise")
mise.hub(lockfile = "//.config/mise:mise.lock")
use_repo(mise, "mise")

register_toolchains("@mise//toolchains:all")

mise_sdks = use_repo_rule("//.config/bazel:mise_sdks.bzl", "mise_sdks")

mise_sdks(
    name = "mise_sdks",
    config = "//.config/mise:config.toml",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = [])

register_toolchains(
    "@mise_sdks//:rust_toolchain",
    "@mise_sdks//:cargo_toolchain",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# Resolve Rust dependencies from the Cargo workspace lockfile. crate_universe
# discovers workspace members from the root manifest.
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rsworkspace:Cargo.lock",
    host_tools = "@mise_sdks//rust:ROOT",
    manifests = ["//rsworkspace:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.wrap(root_file = "@mise_sdks//go:ROOT")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//goworkspace:go.mod")
use_repo(
    go_deps,
    "com_github_google_cel_go",
    "com_github_stretchr_testify",
    "org_golang_google_protobuf",
)
