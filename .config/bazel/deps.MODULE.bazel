bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")

# Build scripts that the coverage instrumentation filter excludes still compile
# their C code with coverage, which embeds timestamps and changes every
# downstream Rust cache key. Not reported upstream yet; drop the patch once
# rules_rust skips coverage for uninstrumented build scripts.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//.config/bazel:patches/rules_rust-native-coverage-filter.patch",
        "//.config/bazel:rules_rust_coverage.patch",
    ],
)

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "aspect_rules_js", version = "3.6.1")
single_version_override(
    module_name = "aspect_rules_js",
    patch_strip = 1,
    patches = ["//.config/bazel:aspect_rules_js_coverage.patch"],
    version = "3.6.1",
)

bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "mise-bazel")
local_path_override(
    module_name = "mise-bazel",
    path = "projects/mise-bazel",
)

# Every tool pinned in the mise configuration, linked from mise's installs.
# Bazel resolves a tool only when a target uses it.
mise = use_extension("@mise-bazel//mise:extensions.bzl", "mise")
mise.config(file = "//.config/mise:config.toml")
use_repo(mise, "mise", "mise_go", "mise_node", "mise_rust")

# Registered before the toolchains that rules_nodejs declares for itself, so
# Bazel resolves Node.js to the mise install and never downloads one.
register_toolchains(
    "@mise_node//:node_toolchain",
    "@mise_node//:node_runtime_toolchain",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = [])

register_toolchains(
    "@mise_rust//:rust_toolchain",
    "@mise_rust//:cargo_toolchain",
    "@mise_rust//:rustfmt_toolchain",
    "@mise_rust//:rust_toolchain_wasm32-unknown-unknown",
)

# Python targets run on a pinned interpreter that rules_python downloads, so
# they never depend on whichever python3 a runner happens to have.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

