        "clusterrolebinding-rbac-v1": "3f83a2198fe9c178bf742849df9a3fb719fe2f3bb8ef425fee855931dad554cf",
        "configmap-v1": "fed751af12c2873a7db2b4cd1294c2959497fda8520f1fc8e5d21adf967ad72e",
