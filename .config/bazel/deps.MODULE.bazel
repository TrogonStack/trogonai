crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# C code compiled by build scripts embeds the sandbox path, which differs per
# run, so downstream Rust cache keys never matched. The runner expands ${pwd};
# rules_rust appends these to the C toolchain flags. Drop this once rules_rust
# ships the same remapping:
# https://github.com/bazelbuild/rules_rust/issues/4407
# https://github.com/bazelbuild/rules_rust/pull/4408
crate.annotation(
    build_script_env = {
        "CFLAGS": "-ffile-prefix-map=$${pwd}=.",
        "CXXFLAGS": "-ffile-prefix-map=$${pwd}=.",
    },
    crate = "*",
    repositories = ["crates"],
)

# Resolve Rust dependencies from the Cargo workspace lockfile. crate_universe
# discovers workspace members from the root manifest.
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rsworkspace:Cargo.lock",
    host_tools = "@mise_rust//:ROOT",
    manifests = ["//rsworkspace:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)

# The decider components under rsworkspace/wasm-components build for wasm32,
# where the workspace resolution above does not fit: it unifies features across
# every member, which pulls host-only dependencies into the guest. This one
# holds the external dependencies of the crates a component reaches, declared
# as their Cargo manifests declare them, so Cargo resolves the same features it
# does for `cargo component build`. The cargo_workspace extension lists which
# of these each crate uses. Its lockfile keeps the versions rsworkspace/Cargo.lock
# pins, which //.config/bazel:wasm_components_lockfile_test checks.
crate.from_specs(
    name = "crates_wasm",
    cargo_lockfile = "//.config/bazel:wasm-components.Cargo.lock",
    host_tools = "@mise_rust//:ROOT",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
    ],
)
crate.spec(
    features = ["json"],
    package = "buffa",
    repositories = ["crates_wasm"],
    version = "=0.9.2",
)
crate.spec(
    package = "buffa-descriptor",
    repositories = ["crates_wasm"],
    version = "=0.9.2",
)
crate.spec(
    features = ["json"],
    package = "buffa-types",
    repositories = ["crates_wasm"],
    version = "=0.9.2",
)
crate.spec(
    default_features = False,
    features = ["std"],
    package = "chrono",
    repositories = ["crates_wasm"],
    version = "=0.4.45",
)
crate.spec(
    package = "chrono-tz",
    repositories = ["crates_wasm"],
    version = "=0.10.4",
)
crate.spec(
    package = "cron",
    repositories = ["crates_wasm"],
    version = "=0.17.0",
)
crate.spec(
    features = ["derive"],
    package = "serde",
    repositories = ["crates_wasm"],
    version = "=1.0.229",
)
crate.spec(
    package = "serde_json",
    repositories = ["crates_wasm"],
    version = "=1.0.154",
)
crate.spec(
    package = "thiserror",
    repositories = ["crates_wasm"],
    version = "=2.0.21",
)
crate.spec(
    default_features = False,
    package = "uuid",
    repositories = ["crates_wasm"],
    version = "=1.24.0",
)
crate.spec(
    package = "wit-bindgen",
    repositories = ["crates_wasm"],
    version = "=0.63.0",
)
use_repo(crate, "crates", "crates_wasm")

# Every Rust BUILD.bazel calls workspace_crate(), which reads its targets,
# features, and workspace dependencies from this repository. It runs
# `cargo metadata` with the mise toolchain and reruns when a Cargo manifest or
# the lockfile changes, so Cargo stays the only place they are declared.
cargo_workspace = use_extension("//.config/bazel:cargo_workspace.bzl", "cargo_workspace")
cargo_workspace.workspace(
    name = "cargo_workspace",
    lockfile = "//rsworkspace:Cargo.lock",
    manifest = "//rsworkspace:Cargo.toml",
    rust_root = "@mise_rust//:ROOT",
)
use_repo(cargo_workspace, "cargo_workspace")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.wrap(root_file = "@mise_go//:ROOT")

# Runs the go vet analyzers on every compile of the repository's own Go code.
go_sdk.nogo(
    includes = ["//goworkspace:__subpackages__"],
    nogo = "//goworkspace:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//goworkspace:go.mod")
use_repo(
    go_deps,
    "com_github_google_cel_go",
    "com_github_stretchr_testify",
    "org_golang_google_protobuf",
)

# One translation per pnpm lockfile. pnpm owns the lockfiles; Bazel only reads them.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_docs",
    data = [
        "//docs:package.json",
        "//docs:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//docs:pnpm-lock.yaml",
    update_pnpm_lock = False,
    verify_node_modules_ignored = "//:.bazelignore",
)
npm.npm_translate_lock(
    name = "npm_tsworkspace",
    data = [
        "//tsworkspace:package.json",
        "//tsworkspace:pnpm-workspace.yaml",
        "//tsworkspace/apps/console:package.json",
        "//tsworkspace/packages/proto:package.json",
        "//tsworkspace/packages/sandbox-ws-client:package.json",
        "//tsworkspace/packages/slack-bolt-fixtures:package.json",
    ],
    npmrc = "//tsworkspace:.npmrc",
    pnpm_lock = "//tsworkspace:pnpm-lock.yaml",
    # Some packages reach modules they do not declare: jest-dom augments and
    # imports vitest, and the TanStack declarations import react, whose types
    # live in @types/react. pnpm makes that work through its hidden hoisting,
    # which rules_js does not reproduce, so these are hoisted explicitly to
    # the workspace root, where the lookup from the package store reaches them.
    public_hoist_packages = {
        "@types/react": ["tsworkspace"],
        "vitest": ["tsworkspace"],
    },
    update_pnpm_lock = False,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm_docs", "npm_tsworkspace")

# rules_ts runs its own copy of the TypeScript compiler, fetched from the npm
# registry. The version comes from the console package manifest and the
# integrity from the same pnpm lockfile entry, so both stay in step with pnpm.
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(
    integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
    version_from = "//tsworkspace/apps/console:package.json",
)
use_repo(typescript, "npm_typescript")
