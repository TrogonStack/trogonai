+fn find_coverage_objects(
+    execroot: &Path,
+    runfiles_dir: Option<&Path>,
+    coverage_dir: &Path,
+) -> io::Result<Vec<PathBuf>> {
+    let declared = match env::var("RUST_COVERAGE_OBJECTS") {
+        Ok(value) => value,
+        Err(env::VarError::NotPresent) => return Ok(Vec::new()),
+        Err(error) => return Err(io::Error::new(io::ErrorKind::InvalidInput, error)),
+    };
+    let paths: Vec<_> = declared.lines().filter(|line| !line.is_empty()).collect();
+    if paths.len() > 1024 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "too many coverage objects",
+        ));
+    }
+    let mut objects = BTreeSet::new();
+    for value in paths {
+        let relative = Path::new(value);
+        if !relative
+            .components()
+            .all(|part| matches!(part, Component::Normal(_)))
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "coverage objects must be runfiles-relative paths",
+            ));
+        }
+        let runfile = match runfiles_dir {
+            Some(directory) => {
+                let workspace = env::var("TEST_WORKSPACE")
+                    .map_err(|error| io::Error::new(io::ErrorKind::InvalidInput, error))?;
+                Some(directory.join(workspace).join(relative))
+            }
+            None => None,
+        };
+        let fallback = execroot
+            .join(config_bin_dir(execroot, coverage_dir))
+            .join(relative);
+        let object = runfile
+            .into_iter()
+            .chain(std::iter::once(fallback))
+            .find(|path| path.is_file())
+            .ok_or_else(|| {
+                io::Error::new(
+                    io::ErrorKind::NotFound,
+                    "declared coverage object is unavailable",
+                )
+            })?;
+        objects.insert(object);
+    }
+    Ok(objects.into_iter().collect())
+}
